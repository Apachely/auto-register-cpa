diff --git a/src/features/providerKeyImport/ProviderKeyImportPage.module.scss b/src/features/providerKeyImport/ProviderKeyImportPage.module.scss
new file mode 100644
index 0000000000000000000000000000000000000000..cea1826c178143b596d26bb6036e866bd652cd27
--- /dev/null
+++ b/src/features/providerKeyImport/ProviderKeyImportPage.module.scss
@@ -0,0 +1,130 @@
+.page {
+  display: flex;
+  flex-direction: column;
+  gap: $spacing-lg;
+  min-width: 0;
+}
+
+.header {
+  display: flex;
+  align-items: flex-start;
+  gap: $spacing-md;
+  color: var(--text-primary);
+
+  svg {
+    flex: none;
+    margin-top: $spacing-xs;
+    color: var(--text-secondary);
+  }
+
+  h1 {
+    font-size: clamp(20px, 3vw, 26px);
+    font-weight: 700;
+  }
+
+  p {
+    margin-top: $spacing-xs;
+    color: var(--text-secondary);
+    font-size: 13px;
+  }
+}
+
+.workspace {
+  display: grid;
+  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
+  align-items: start;
+  gap: $spacing-md;
+
+  @media (max-width: $breakpoint-tablet) {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+.card {
+  min-width: 0;
+}
+
+.keys {
+  resize: vertical;
+  font-family: $font-mono;
+  font-size: 13px;
+}
+
+.hint {
+  color: var(--text-secondary);
+  font-size: 13px;
+}
+
+.stage {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: $spacing-sm;
+}
+
+.progress {
+  display: block;
+  width: 100%;
+  height: 8px;
+  margin: $spacing-md 0;
+  accent-color: var(--primary-color);
+}
+
+.timeline,
+.rows {
+  &:not(:empty) {
+    margin-top: $spacing-md;
+    border-top: 0.5px solid var(--border-color);
+  }
+
+  li {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: $spacing-sm;
+    padding: $spacing-sm 0;
+    border-bottom: 0.5px solid var(--border-color);
+    font-size: 13px;
+  }
+}
+
+.timeline {
+  color: var(--text-secondary);
+
+  time {
+    font-variant-numeric: tabular-nums;
+  }
+}
+
+.rows {
+  max-height: 280px;
+  overflow-y: auto;
+}
+
+.result {
+  padding: 2px 8px;
+  border: 0.5px solid var(--border-color);
+  border-radius: $radius-full;
+  background: var(--bg-tertiary);
+  color: var(--text-secondary);
+  font-size: 12px;
+
+  &[data-status='added'] {
+    background: var(--success-badge-bg);
+    color: var(--success-badge-text);
+    border-color: var(--success-badge-border);
+  }
+
+  &[data-status='invalid'],
+  &[data-status='not_written'] {
+    background: var(--failure-badge-bg);
+    color: var(--failure-badge-text);
+    border-color: var(--failure-badge-border);
+  }
+
+  &[data-status='unknown'] {
+    background: var(--amber-10);
+    color: var(--amber-text);
+    border-color: var(--amber-30);
+  }
+}
diff --git a/src/features/providerKeyImport/ProviderKeyImportPage.tsx b/src/features/providerKeyImport/ProviderKeyImportPage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c4a79b1bb62f26ee7fdc67e0d01bcd62dc57a1dc
--- /dev/null
+++ b/src/features/providerKeyImport/ProviderKeyImportPage.tsx
@@ -0,0 +1,262 @@
+import { useCallback, useEffect, useId, useMemo, useRef, useState, type FormEvent } from 'react';
+import { useTranslation } from 'react-i18next';
+import { usePageTransitionLayer } from '@/components/common/PageTransitionLayer';
+import { Button } from '@/components/ui/Button';
+import { Card } from '@/components/ui/Card';
+import { EmptyState } from '@/components/ui/EmptyState';
+import { IconUpload } from '@/components/ui/icons';
+import { Select } from '@/components/ui/Select';
+import { useHeaderRefresh } from '@/hooks/useHeaderRefresh';
+import { apiClient } from '@/services/api/client';
+import { createProviderKeyImportClient } from '@/services/api/providerKeyImport';
+import { useAuthStore, useConfigStore } from '@/stores';
+import {
+  findImportDestinations,
+  importDestinationLabel,
+  MAX_KEY_IMPORT_ROWS,
+  runProviderKeyImport,
+  type ImportDestination,
+  type ImportStage,
+  type ImportUpdate,
+} from './batch';
+import styles from './ProviderKeyImportPage.module.scss';
+
+type DestinationList =
+  { state: 'loading' | 'error' } | { state: 'ready'; items: ImportDestination[] };
+
+type TimelineEntry = { stage: ImportStage; at: number };
+
+function ImportWorkbench() {
+  const { t, i18n } = useTranslation();
+  const id = useId();
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+  const loadRef = useRef<AbortController | null>(null);
+  const importRef = useRef<AbortController | null>(null);
+  const [destinations, setDestinations] = useState<DestinationList>({ state: 'loading' });
+  const [selection, setSelection] = useState('');
+  const [update, setUpdate] = useState<ImportUpdate | null>(null);
+  const [timeline, setTimeline] = useState<TimelineEntry[]>([]);
+  const [hasInput, setHasInput] = useState(false);
+  const busy = update !== null && update.stage !== 'finished';
+
+  const resetDraft = useCallback(() => {
+    if (textareaRef.current) textareaRef.current.value = '';
+    setHasInput(false);
+    setUpdate(null);
+    setTimeline([]);
+  }, []);
+
+  const load = useCallback(async () => {
+    if (importRef.current) return;
+    loadRef.current?.abort();
+    const controller = new AbortController();
+    loadRef.current = controller;
+    const client = createProviderKeyImportClient(
+      () => loadRef.current === controller,
+      controller.signal
+    );
+    resetDraft();
+    setSelection('');
+    setDestinations({ state: 'loading' });
+    try {
+      const { groups } = await client.read();
+      if (!client.isCurrent()) return;
+      const items = findImportDestinations(groups);
+      setDestinations({ state: 'ready', items });
+      if (items.length === 1) setSelection('0');
+    } catch {
+      if (client.isCurrent()) setDestinations({ state: 'error' });
+    } finally {
+      if (loadRef.current === controller) loadRef.current = null;
+    }
+  }, [resetDraft]);
+
+  useHeaderRefresh(load);
+  useEffect(() => {
+    void load();
+    return () => {
+      loadRef.current?.abort();
+      importRef.current?.abort();
+    };
+  }, [load]);
+
+  const options = useMemo(
+    () =>
+      destinations.state === 'ready'
+        ? destinations.items.map((item, index) => ({
+            value: String(index),
+            label: importDestinationLabel(item),
+          }))
+        : [],
+    [destinations]
+  );
+  const target =
+    destinations.state === 'ready' && selection !== ''
+      ? destinations.items[Number(selection)]?.target
+      : undefined;
+  const total = update?.rows.length ?? 0;
+  const completed = update?.rows.filter(({ status }) => status !== 'pending').length ?? 0;
+  const stage = update?.stage ?? 'idle';
+
+  const submit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (importRef.current || !target || !textareaRef.current) return;
+    const source = textareaRef.current.value;
+    if (!source.trim()) return;
+    resetDraft();
+    const controller = new AbortController();
+    importRef.current = controller;
+    const client = createProviderKeyImportClient(
+      () => importRef.current === controller,
+      controller.signal
+    );
+    try {
+      await runProviderKeyImport(client, target, source, (next) => {
+        setUpdate(next);
+        const at = Date.now();
+        setTimeline((previous) => [...previous, { stage: next.stage, at }]);
+        if (next.rows.some(({ status }) => status === 'added' || status === 'unknown')) {
+          useConfigStore.getState().clearCache('openai-compatibility');
+        }
+      });
+    } finally {
+      if (importRef.current === controller) importRef.current = null;
+    }
+  };
+
+  return (
+    <div className={styles.workspace}>
+      <Card className={styles.card} title={t('provider_key_import.input_title')}>
+        {destinations.state === 'loading' ? (
+          <p role="status" className={styles.hint}>
+            {t('provider_key_import.loading')}
+          </p>
+        ) : destinations.state === 'error' ? (
+          <EmptyState
+            title={t('provider_key_import.load_failed')}
+            action={
+              <Button variant="secondary" size="sm" onClick={() => void load()}>
+                {t('provider_key_import.reload')}
+              </Button>
+            }
+          />
+        ) : options.length === 0 ? (
+          <EmptyState
+            title={t('provider_key_import.no_destinations')}
+            description={t('provider_key_import.no_destinations_hint')}
+          />
+        ) : (
+          <form onSubmit={(event) => void submit(event)}>
+            <div className="form-group">
+              <label htmlFor={`${id}-destination`}>{t('provider_key_import.destination')}</label>
+              <Select
+                id={`${id}-destination`}
+                value={selection}
+                options={options}
+                placeholder={t('provider_key_import.choose_destination')}
+                disabled={busy}
+                onChange={(value) => {
+                  resetDraft();
+                  setSelection(value);
+                }}
+              />
+            </div>
+            <div className="form-group">
+              <label htmlFor={`${id}-keys`}>{t('provider_key_import.keys')}</label>
+              <textarea
+                id={`${id}-keys`}
+                ref={textareaRef}
+                className={styles.keys}
+                rows={7}
+                autoComplete="off"
+                autoCapitalize="off"
+                spellCheck={false}
+                disabled={!target || busy}
+                aria-describedby={`${id}-hint`}
+                onInput={(event) => setHasInput(Boolean(event.currentTarget.value.trim()))}
+              />
+              <p id={`${id}-hint`} className="hint">
+                {t('provider_key_import.key_hint', { limit: MAX_KEY_IMPORT_ROWS })}
+              </p>
+            </div>
+            <Button type="submit" loading={busy} disabled={!target || !hasInput}>
+              {t('provider_key_import.import')}
+            </Button>
+          </form>
+        )}
+      </Card>
+      <Card className={styles.card} title={t('provider_key_import.progress_title')}>
+        <p className={styles.stage}>
+          <span className="pill">{t(`provider_key_import.stage.${stage}`)}</span>
+          {total > 0 && (
+            <span className={styles.hint}>
+              {t('provider_key_import.completed', { done: completed, total })}
+            </span>
+          )}
+        </p>
+        {total > 0 && (
+          <progress
+            className={styles.progress}
+            max={total}
+            value={completed}
+            aria-label={t('provider_key_import.progress_title')}
+          />
+        )}
+        {update?.error && (
+          <div className="error-box" role="alert">
+            {t(`provider_key_import.error.${update.error}`)}
+          </div>
+        )}
+        <ol className={styles.timeline} role="log" aria-label={t('provider_key_import.timeline')}>
+          {timeline.map(({ stage: entryStage, at }) => (
+            <li key={entryStage}>
+              <time dateTime={new Date(at).toISOString()}>
+                {new Date(at).toLocaleTimeString(i18n.language)}
+              </time>
+              <span>{t(`provider_key_import.stage.${entryStage}`)}</span>
+            </li>
+          ))}
+        </ol>
+        {update && total > 0 && (
+          <ul className={styles.rows} aria-label={t('provider_key_import.rows')}>
+            {update.rows.map(({ line, status }) => (
+              <li key={line}>
+                <span>{t('provider_key_import.line', { line })}</span>
+                <span className={styles.result} data-status={status}>
+                  {t(`provider_key_import.row.${status}`)}
+                </span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </Card>
+    </div>
+  );
+}
+
+export function ProviderKeyImportPage() {
+  const { t } = useTranslation();
+  const current = usePageTransitionLayer()?.isCurrentLayer ?? true;
+  const revision = useAuthStore((state) =>
+    state.isAuthenticated && state.connectionStatus === 'connected'
+      ? apiClient.getConnectionRevision()
+      : -1
+  );
+  return (
+    <div className={styles.page}>
+      <header className={styles.header}>
+        <IconUpload size={24} />
+        <div>
+          <h1>{t('provider_key_import.title')}</h1>
+          <p>{t('provider_key_import.description')}</p>
+        </div>
+      </header>
+      {current &&
+        (revision >= 0 ? (
+          <ImportWorkbench key={revision} />
+        ) : (
+          <EmptyState title={t('notification.connection_required')} />
+        ))}
+    </div>
+  );
+}
diff --git a/src/features/providerKeyImport/batch.ts b/src/features/providerKeyImport/batch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0d92b5571e44e8ed0df9949f26d7fb8df4cbc8ec
--- /dev/null
+++ b/src/features/providerKeyImport/batch.ts
@@ -0,0 +1,233 @@
+import { isRecord } from '@/utils/helpers';
+
+export const MAX_KEY_IMPORT_ROWS = 100;
+export const MAX_KEY_IMPORT_LENGTH = MAX_KEY_IMPORT_ROWS * 514;
+
+export interface ImportTarget {
+  name: string;
+  baseUrl: string;
+  prefix: string;
+}
+
+export interface ImportDestination {
+  target: ImportTarget;
+  endpoint: string;
+}
+
+export type ImportStage = 'validating' | 'reading' | 'writing' | 'finished';
+export type RowStatus =
+  'invalid' | 'duplicate' | 'already_present' | 'pending' | 'added' | 'not_written' | 'unknown';
+
+export interface ImportRow {
+  line: number;
+  status: RowStatus;
+}
+
+type ImportError =
+  | 'empty'
+  | 'batch_limit'
+  | 'config_unavailable'
+  | 'destination_changed'
+  | 'proxy_mismatch'
+  | 'conflict'
+  | 'write_rejected'
+  | 'write_unconfirmed';
+
+export interface ImportUpdate {
+  stage: ImportStage;
+  rows: readonly ImportRow[];
+  error?: ImportError;
+}
+
+interface ImportClient {
+  read(): Promise<{ groups: Record<string, unknown>[]; etag: string }>;
+  write(groups: Record<string, unknown>[], etag: string): Promise<void>;
+  isCurrent(): boolean;
+}
+
+function targetOf(group: Record<string, unknown>): ImportTarget | null {
+  const name = typeof group.name === 'string' ? group.name.trim() : '';
+  const baseUrl = typeof group['base-url'] === 'string' ? group['base-url'].trim() : '';
+  const prefix = typeof group.prefix === 'string' ? group.prefix.trim() : '';
+  if (!name || !/^https?:\/\//i.test(baseUrl)) return null;
+  try {
+    const url = new URL(baseUrl);
+    if (
+      !['https:', 'http:'].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    )
+      return null;
+  } catch {
+    return null;
+  }
+  return { name, baseUrl, prefix };
+}
+
+function sameTarget(a: ImportTarget | null, b: ImportTarget): boolean {
+  return a !== null && a.name === b.name && a.baseUrl === b.baseUrl && a.prefix === b.prefix;
+}
+
+export function importDestinationLabel({ target, endpoint }: ImportDestination): string {
+  return [target.name, endpoint, target.prefix].filter(Boolean).join(' · ');
+}
+
+export function findImportDestinations(groups: Record<string, unknown>[]): ImportDestination[] {
+  const counts = new Map<string, number>();
+  const candidates = groups.flatMap((group) => {
+    const target = targetOf(group);
+    if (!target) return [];
+    const url = new URL(target.baseUrl);
+    const candidate = { target, endpoint: `${url.origin}${url.pathname}` };
+    const label = importDestinationLabel(candidate);
+    counts.set(label, (counts.get(label) ?? 0) + 1);
+    return [candidate];
+  });
+  // The displayed identity must also be unambiguous after URL normalization.
+  return candidates.filter((candidate) => counts.get(importDestinationLabel(candidate)) === 1);
+}
+
+function parseRows(source: string) {
+  const rows: ImportRow[] = [];
+  const keys = new Map<number, string>();
+  const seen = new Set<string>();
+  for (const [index, value] of source.split(/\r\n?|\n/).entries()) {
+    const key = value.trim();
+    if (!key) continue;
+    const line = index + 1;
+    // Only one opaque key per line; URLs, account/password pairs and headers are not imports.
+    if (!/^[A-Za-z0-9._~+/=-]{8,512}$/.test(key)) {
+      rows.push({ line, status: 'invalid' });
+    } else if (seen.has(key)) {
+      rows.push({ line, status: 'duplicate' });
+    } else {
+      seen.add(key);
+      keys.set(line, key);
+      rows.push({ line, status: 'pending' });
+    }
+  }
+  return { rows, keys };
+}
+
+function statusOf(error: unknown) {
+  return isRecord(error) && typeof error.status === 'number' ? error.status : undefined;
+}
+
+function canRoundTripGroups(groups: Record<string, unknown>[]): boolean {
+  // The v8 endpoint replaces the family as a whole. Do not reserialize config
+  // numbers the browser may already have rounded or parsed as infinity.
+  const remaining: unknown[] = [groups];
+  while (remaining.length) {
+    const value = remaining.pop();
+    if (typeof value === 'number') {
+      if (!Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER) return false;
+    } else if (Array.isArray(value)) {
+      for (const item of value) remaining.push(item);
+    } else if (isRecord(value)) {
+      for (const item of Object.values(value)) remaining.push(item);
+    }
+  }
+  return true;
+}
+
+/** All progress data is safe to display: only stages, line numbers, outcomes and fixed error codes. */
+export async function runProviderKeyImport(
+  client: ImportClient,
+  destination: ImportTarget,
+  source: string,
+  onUpdate: (update: ImportUpdate) => void
+): Promise<void> {
+  let rows: ImportRow[] = [];
+  const emit = (stage: ImportStage, error?: ImportError) => {
+    if (client.isCurrent()) onUpdate({ stage, rows, error });
+  };
+  const finish = (status: RowStatus, error?: ImportError) => {
+    rows = rows.map((row) => (row.status === 'pending' ? { ...row, status } : row));
+    emit('finished', error);
+  };
+  emit('validating');
+  if (!client.isCurrent()) return;
+  if (source.length > MAX_KEY_IMPORT_LENGTH) return finish('not_written', 'batch_limit');
+  const parsed = parseRows(source);
+  try {
+    rows = parsed.rows;
+    if (rows.length > MAX_KEY_IMPORT_ROWS) {
+      rows = [];
+      return finish('not_written', 'batch_limit');
+    }
+    if (rows.length === 0) return finish('not_written', 'empty');
+    if (parsed.keys.size === 0) return finish('not_written');
+
+    emit('reading');
+    let snapshot: Awaited<ReturnType<ImportClient['read']>>;
+    try {
+      snapshot = await client.read();
+    } catch {
+      return finish('not_written', 'config_unavailable');
+    }
+    if (!client.isCurrent()) return;
+    const { groups, etag } = snapshot;
+    // CPA v8 uses the on-disk SHA-256 as a strong quoted ETag. Never write without it.
+    if (!/^"[a-f0-9]{64}"$/.test(etag)) return finish('not_written', 'config_unavailable');
+    if (!findImportDestinations(groups).some(({ target }) => sameTarget(target, destination))) {
+      return finish('not_written', 'destination_changed');
+    }
+    const group = groups.find((item) => sameTarget(targetOf(item), destination));
+    if (!group) return finish('not_written', 'destination_changed');
+    const existing = group.keys;
+    if (!Array.isArray(existing) || !existing.every(isRecord)) {
+      return finish('not_written', 'config_unavailable');
+    }
+    const seen = new Set(
+      existing.flatMap((entry) =>
+        typeof entry['api-key'] === 'string' ? [entry['api-key'].trim()] : []
+      )
+    );
+    rows = rows.map((row) => {
+      const key = parsed.keys.get(row.line);
+      if (!key || !seen.has(key)) return row;
+      parsed.keys.delete(row.line);
+      return { ...row, status: 'already_present' };
+    });
+    if (parsed.keys.size === 0) return finish('not_written');
+    if (!canRoundTripGroups(groups)) return finish('not_written', 'config_unavailable');
+
+    // Keep the current provider's ordinary CPA egress policy. Do not pick a route
+    // when existing credentials disagree, and do not contact any proxy/upstream.
+    const existingProxies = new Set(
+      existing.map((entry) => {
+        const proxy = entry['proxy-url'];
+        return proxy == null ? '' : typeof proxy === 'string' ? proxy.trim() : null;
+      })
+    );
+    if (existingProxies.has(null) || existingProxies.size > 1) {
+      return finish('not_written', 'proxy_mismatch');
+    }
+    const proxy = existingProxies.values().next().value;
+    const additions = Array.from(parsed.keys.values(), (key) => ({
+      'api-key': key,
+      ...(proxy ? { 'proxy-url': proxy } : {}),
+    }));
+    const next = groups.map((item) =>
+      item === group ? { ...group, keys: [...existing, ...additions] } : item
+    );
+    emit('writing');
+    if (!client.isCurrent()) return;
+    try {
+      await client.write(next, etag);
+      finish('added');
+    } catch (error: unknown) {
+      const status = statusOf(error);
+      if (status === 409 || status === 412) return finish('not_written', 'conflict');
+      if (status !== undefined && status >= 400 && status < 500 && status !== 408) {
+        return finish('not_written', 'write_rejected');
+      }
+      // A lost response is not proof that CPA did not save the batch.
+      finish('unknown', 'write_unconfirmed');
+    }
+  } finally {
+    parsed.keys.clear();
+  }
+}
