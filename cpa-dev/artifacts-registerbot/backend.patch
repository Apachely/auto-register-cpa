new file mode 100644
index 0000000..9df0f5c
--- /dev/null
+++ b/internal/registerbot/events.go
@@ -0,0 +1,371 @@
+package registerbot
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	log "github.com/sirupsen/logrus"
+)
+
+// Stages of one account inside a channel queue. They are stable wire values: the
+// panel maps them to labels, so renames must update both sides.
+const (
+	StageQueued       = "queued"
+	StageValidating   = "validating"
+	StagePinning      = "pinning"
+	StageBrowserStart = "browser_start"
+	StageGoogleLogin  = "google_login"
+	StageWaitingHuman = "waiting_human"
+	StageCapturingKey = "capturing_key"
+	StageVerifyingKey = "verifying_key"
+	StageWritingKey   = "writing_key"
+	StageDone         = "done"
+	StageFailed       = "failed"
+	StageSkipped      = "skipped"
+	StagePaused       = "paused"
+)
+
+// Terminal stages close an account row.
+func IsTerminal(stage string) bool {
+	switch stage {
+	case StageDone, StageFailed, StageSkipped:
+		return true
+	}
+	return false
+}
+
+// Event is one journal entry. Reasons are stage names or sanitized causes only:
+// passwords, cookies, tokens, callback parameters and raw upstream bodies never
+// enter the journal, and API keys are stored as masked hints.
+type Event struct {
+	Seq      int64     `json:"seq"`
+	At       int64     `json:"at"`
+	Channel  string    `json:"channel"`
+	Run      string    `json:"run,omitempty"`
+	Account  string    `json:"account,omitempty"`
+	Stage    string    `json:"stage"`
+	Level    string    `json:"level,omitempty"`
+	Message  string    `json:"message,omitempty"`
+	Node     string    `json:"node,omitempty"`
+	ExitIP   string    `json:"exit_ip,omitempty"`
+	Browser  string    `json:"browser,omitempty"`
+	Evidence string    `json:"evidence,omitempty"`
+	Masked   string    `json:"masked,omitempty"`
+	Counters *Counters `json:"counters,omitempty"`
+}
+
+// Counters is the live progress snapshot carried by progress events.
+type Counters struct {
+	ChannelID string `json:"channel"`
+	Total     int    `json:"total"`
+	Queued    int    `json:"queued"`
+	Running   int    `json:"running"`
+	Done      int    `json:"done"`
+	Failed    int    `json:"failed"`
+	Skipped   int    `json:"skipped"`
+	Waiting   int    `json:"waiting_human"`
+	Pending   int    `json:"pending_write"`
+	Target    int    `json:"target_keys,omitempty"`
+	Got       int    `json:"harvested_keys"`
+	Stage     string `json:"stage,omitempty"`
+	Stalled   bool   `json:"stalled,omitempty"`
+	UpdatedAt int64  `json:"updated_at"`
+}
+
+// Bus stores the journal and fans events out to live subscribers.
+//
+// Replay works by sequence number, exactly like the log cursor design: a client
+// that reconnects asks for "after seq" and continues where it stopped, so nothing
+// is lost when the panel closes or CPA restarts. Entries are also appended to disk.
+type Bus struct {
+	dir  string
+	file *os.File
+
+	mu        sync.Mutex
+	entries   []Event
+	ringLimit int
+	bySeq     int64
+	subs      map[int]chan Event
+	nextSub   int
+	// written counts journal lines appended to disk for rotation decisions.
+	written int
+}
+
+// NewBus opens the journal below dir and rebuilds the sequence counter.
+func NewBus(dir string, ringLimit int) (*Bus, error) {
+	if ringLimit <= 0 {
+		ringLimit = 2000
+	}
+	if errMkdir := os.MkdirAll(dir, 0o750); errMkdir != nil {
+		return nil, fmt.Errorf("registerbot: create journal dir: %w", errMkdir)
+	}
+	path := filepath.Join(dir, "events.jsonl")
+	file, errOpen := os.OpenFile(path, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0o600)
+	if errOpen != nil {
+		return nil, fmt.Errorf("registerbot: open journal: %w", errOpen)
+	}
+	bus := &Bus{dir: dir, file: file, ringLimit: ringLimit, subs: make(map[int]chan Event)}
+	if errReplay := bus.replay(path); errReplay != nil {
+		log.WithError(errReplay).Warn("registerbot: journal replay skipped part of the history")
+	}
+	return bus, nil
+}
+
+// replay loads the tail of the on-disk journal so seq keeps monotonic after restart.
+func (b *Bus) replay(path string) error {
+	file, errOpen := os.Open(path)
+	if errOpen != nil {
+		return errOpen
+	}
+	defer func() {
+		if errClose := file.Close(); errClose != nil {
+			log.Warn("registerbot journal close failed")
+		}
+	}()
+	scanner := bufio.NewScanner(file)
+	scanner.Buffer(make([]byte, 4096), 1024*1024)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" {
+			continue
+		}
+		var event Event
+		if errUnmarshal := json.Unmarshal([]byte(line), &event); errUnmarshal != nil {
+			continue
+		}
+		b.entries = append(b.entries, event)
+		if event.Seq > b.bySeq {
+			b.bySeq = event.Seq
+		}
+		b.written++
+		if len(b.entries) > b.ringLimit*2 {
+			b.entries = append([]Event(nil), b.entries[len(b.entries)-b.ringLimit:]...)
+		}
+	}
+	if len(b.entries) > b.ringLimit {
+		b.entries = append([]Event(nil), b.entries[len(b.entries)-b.ringLimit:]...)
+	}
+	return scanner.Err()
+}
+
+// NextSeq returns the sequence number the next event will take.
+func (b *Bus) NextSeq() int64 {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.bySeq + 1
+}
+
+// Emit appends one event and notifies subscribers. The journal never blocks a run:
+// a subscriber whose buffer is full is dropped, and live viewers resync by cursor.
+func (b *Bus) Emit(event Event) Event {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.bySeq++
+	event.Seq = b.bySeq
+	event.Message = keyPattern.ReplaceAllString(event.Message, "[redacted-key]")
+	if len(event.Message) > 1024 {
+		event.Message = event.Message[:1024]
+	}
+	if event.At == 0 {
+		event.At = time.Now().UnixMilli()
+	}
+	b.entries = append(b.entries, event)
+	if len(b.entries) > b.ringLimit*2 {
+		b.entries = append([]Event(nil), b.entries[len(b.entries)-b.ringLimit:]...)
+	}
+	b.written++
+	if b.file != nil {
+		if payload, errMarshal := json.Marshal(event); errMarshal == nil {
+			if _, errWrite := b.file.Write(append(payload, '\n')); errWrite != nil {
+				log.Warn("registerbot journal write failed")
+			}
+		}
+	}
+	if b.written > b.ringLimit*4 {
+		b.rotateLocked()
+	}
+	for id, ch := range b.subs {
+		select {
+		case ch <- event:
+		default:
+			delete(b.subs, id)
+			close(ch)
+		}
+	}
+	return event
+}
+
+// rotate archives the journal file and continues in a fresh one.
+func (b *Bus) rotateLocked() {
+	path := filepath.Join(b.dir, "events.jsonl")
+	var data []byte
+	for _, event := range b.entries {
+		payload, errMarshal := json.Marshal(event)
+		if errMarshal != nil {
+			return
+		}
+		data = append(data, payload...)
+		data = append(data, '\n')
+	}
+	if b.file != nil {
+		if errClose := b.file.Close(); errClose != nil {
+			log.Warn("registerbot journal rotation close failed")
+		}
+		b.file = nil
+	}
+	if errWrite := atomicWrite(path, data); errWrite != nil {
+		log.Warn("registerbot journal rotation failed")
+	}
+	file, errOpen := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+	if errOpen == nil {
+		b.file = file
+		b.written = len(b.entries)
+	}
+}
+
+// Since returns events with a sequence greater than after, newest last.
+func (b *Bus) Since(after int64, limit int, channel string) []Event {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if limit <= 0 || limit > b.ringLimit {
+		limit = b.ringLimit
+	}
+	var out []Event
+	for _, event := range b.entries {
+		if event.Seq <= after {
+			continue
+		}
+		if channel != "" && event.Channel != channel {
+			continue
+		}
+		out = append(out, event)
+		if len(out) >= limit {
+			break
+		}
+	}
+	return out
+}
+
+// Tail returns the most recent events for an initial paint.
+func (b *Bus) Tail(limit int, channel string) []Event {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if limit <= 0 {
+		limit = 200
+	}
+	out := make([]Event, 0, limit)
+	for i := len(b.entries) - 1; i >= 0 && len(out) < limit; i-- {
+		event := b.entries[i]
+		if channel != "" && event.Channel != channel {
+			continue
+		}
+		out = append(out, event)
+	}
+	for left, right := 0, len(out)-1; left < right; left, right = left+1, right-1 {
+		out[left], out[right] = out[right], out[left]
+	}
+	return out
+}
+
+// LastSeq reports the newest stored sequence number.
+func (b *Bus) LastSeq() int64 {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.bySeq
+}
+
+// Subscribe registers a live viewer and returns its cancel function.
+func (b *Bus) Subscribe(buffer int) (<-chan Event, func()) {
+	if buffer <= 0 {
+		buffer = 128
+	}
+	b.mu.Lock()
+	id := b.nextSub
+	b.nextSub++
+	ch := make(chan Event, buffer)
+	b.subs[id] = ch
+	b.mu.Unlock()
+	return ch, func() {
+		b.mu.Lock()
+		if existing, ok := b.subs[id]; ok {
+			delete(b.subs, id)
+			close(existing)
+		}
+		b.mu.Unlock()
+	}
+}
+
+// Replay resolves a client cursor into a safe starting point.
+//
+// A cursor the journal no longer holds (trimmed by rotation, or newer than the
+// last event after a restart) falls back to the oldest retained event, so the
+// viewer always continues from real history instead of silently missing rows.
+func (b *Bus) Replay(after int64, channel string) (events []Event, cursor int64) {
+	b.mu.Lock()
+	latest, limit := b.bySeq, b.ringLimit
+	b.mu.Unlock()
+	if after < 0 || after > latest {
+		if tail := b.Tail(limit, channel); len(tail) > 0 {
+			after = tail[0].Seq - 1
+		}
+	}
+	events = b.Since(after, limit, channel)
+	cursor = after
+	if len(events) > 0 {
+		cursor = events[len(events)-1].Seq
+	}
+	return events, cursor
+}
+
+// Close releases the journal file.
+func (b *Bus) Close() error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	for id, ch := range b.subs {
+		delete(b.subs, id)
+		close(ch)
+	}
+	if b.file == nil {
+		return nil
+	}
+	errClose := b.file.Close()
+	b.file = nil
+	return errClose
+}
+
+// SubscribeAfter captures replay and subscription under one lock, avoiding gaps.
+func (b *Bus) SubscribeAfter(after int64, channel string, buffer int) ([]Event, <-chan Event, func(), bool) {
+	if buffer <= 0 {
+		buffer = 256
+	}
+	b.mu.Lock()
+	reset := after > b.bySeq || (len(b.entries) > 0 && after < b.entries[0].Seq-1)
+	if reset {
+		after = 0
+	}
+	replay := make([]Event, 0)
+	for _, event := range b.entries {
+		if event.Seq > after && (channel == "" || event.Channel == channel) {
+			replay = append(replay, event)
+		}
+	}
+	id := b.nextSub
+	b.nextSub++
+	ch := make(chan Event, buffer)
+	b.subs[id] = ch
+	b.mu.Unlock()
+	return replay, ch, func() {
+		b.mu.Lock()
+		defer b.mu.Unlock()
+		if existing, ok := b.subs[id]; ok {
+			delete(b.subs, id)
+			close(existing)
+		}
+	}, reset
+}
diff --git a/internal/registerbot/freeai.go b/internal/registerbot/freeai.go
new file mode 100644
index 0000000..c5556b7
--- /dev/null
+++ b/internal/registerbot/freeai.go
@@ -0,0 +1,284 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+)
+
+// FreeAIDriver follows the provider's visible Google sign-in flow. Challenges
+// remain resumable manual work; no challenge or identity checks are bypassed.
+type FreeAIDriver struct{ settings func() Settings }
+
+func NewFreeAIDriver(settings func() Settings) Driver { return &FreeAIDriver{settings: settings} }
+func (d *FreeAIDriver) Kind() string                  { return ChannelKindFreeAIApiKey }
+
+func (d *FreeAIDriver) Probe(ctx context.Context) error {
+	set := DefaultSettings()
+	if d.settings != nil {
+		set = d.settings()
+	}
+	client, errClient := gatewayHTTPClient(set.Gateway.ProxyURL)
+	if errClient != nil {
+		return errClient
+	}
+	defer client.CloseIdleConnections()
+	req, errRequest := http.NewRequestWithContext(ctx, http.MethodGet, "https://freeaiapikey.com/register", nil)
+	if errRequest != nil {
+		return errRequest
+	}
+	resp, errDo := client.Do(req)
+	if errDo != nil {
+		return errors.New("registerbot: provider entry point unavailable")
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode >= 400 {
+		return errors.New("registerbot: provider entry point returned an error")
+	}
+	return nil
+}
+
+type freeAIPage struct {
+	URL            string `json:"url"`
+	Action         string `json:"action"`
+	Key            string `json:"key"`
+	NetworkCode    string `json:"network_code"`
+	HumanChallenge bool   `json:"human_challenge"`
+}
+
+func normalizeFreeAIPage(page freeAIPage) freeAIPage {
+	if page.Action == "challenge" && !page.HumanChallenge {
+		parsed, errParse := url.Parse(page.URL)
+		if errParse == nil && googleIdentityHost(page.URL) && (strings.HasSuffix(parsed.Path, "/challenge/pwd") || strings.HasSuffix(parsed.Path, "/challenge/password")) {
+			page.Action = "loading"
+		}
+	}
+	return page
+}
+
+func freeAIHost(raw string) bool {
+	parsed, errParse := url.Parse(raw)
+	return errParse == nil && (parsed.Hostname() == "freeaiapikey.com" || parsed.Hostname() == "www.freeaiapikey.com") && parsed.Scheme == "https"
+}
+
+func googleIdentityHost(raw string) bool {
+	parsed, errParse := url.Parse(raw)
+	return errParse == nil && parsed.Hostname() == "accounts.google.com" && parsed.Scheme == "https"
+}
+
+// Run retains an isolated page on manual handoff so the operator can resolve a
+// challenge and resume the same registration without submitting credentials again.
+func (d *FreeAIDriver) Run(ctx context.Context, task *Task) (harvest Harvest, runErr error) {
+	if task == nil {
+		return harvest, errors.New("registerbot: missing registration task")
+	}
+	if task.Channel.ManualMode {
+		task.Report("manual", "warn", "manual completion requested")
+		return harvest, ErrManualHandoff
+	}
+	start := strings.TrimSpace(task.Channel.StartURL)
+	if start == "" {
+		start = "https://freeaiapikey.com/register"
+	}
+	if !freeAIHost(start) {
+		return harvest, errors.New("registerbot: FreeAI start URL must use the provider HTTPS origin")
+	}
+	set := DefaultSettings()
+	if d.settings != nil {
+		set = d.settings()
+	}
+	acquireCtx, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+	session, errOpen := task.OpenSession(acquireCtx, start)
+	if errOpen != nil {
+		if ctx.Err() != nil {
+			return harvest, ctx.Err()
+		}
+		if errors.Is(errOpen, ErrManualHandoff) {
+			task.Report("manual", "warn", "browser unavailable; complete registration and supply the API key")
+			return harvest, ErrManualHandoff
+		}
+		task.Report("network_error", "warn", "browser navigation failed; queue retry follows")
+		return harvest, errOpen
+	}
+	defer func() {
+		if errors.Is(runErr, ErrManualHandoff) {
+			return
+		}
+		closeCtx, closeCancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer closeCancel()
+		_ = session.CloseTarget(closeCtx)
+		task.session = nil
+	}()
+	started := time.Now()
+	lastAction := ""
+	lastProgress := time.Now()
+	acted := false
+	ticker := time.NewTicker(700 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if errContext := acquireCtx.Err(); errContext != nil {
+			if ctx.Err() != nil {
+				return harvest, ctx.Err()
+			}
+			task.Report("manual", "warn", "registration is awaiting operator completion")
+			return harvest, ErrManualHandoff
+		}
+		var page freeAIPage
+		_ = session.FollowAuthorizationPopup(acquireCtx)
+		value, errInspect := session.Evaluate(acquireCtx, freeAIInspectScript, false)
+		if errInspect == nil {
+			encoded, errEncode := json.Marshal(value)
+			if errEncode == nil {
+				errInspect = json.Unmarshal(encoded, &page)
+			}
+		}
+		if errInspect != nil {
+			if session.client.loadErr() != nil {
+				return harvest, errors.New("registerbot: browser connection lost")
+			}
+			page.Action = "loading"
+		}
+		page = normalizeFreeAIPage(page)
+		if page.Action != lastAction && page.Action != "loading" {
+			lastAction, lastProgress, acted = page.Action, time.Now(), false
+			task.Report(page.Action, "info", freeAIStageMessage(page.Action))
+		}
+		if page.Action == "key" && freeAIHost(page.URL) && keyPattern.MatchString(page.Key) {
+			return Harvest{APIKey: page.Key, Account: task.Account.Email, Node: task.node, ExitIP: task.exitIP, Browser: task.browserLabel(), StartedAt: started, FinishedAt: time.Now()}, nil
+		}
+		if page.Action == "invalid_credentials" {
+			return harvest, errors.New("registerbot: Google rejected the supplied account credentials")
+		}
+		if page.Action == "network_error" {
+			failure := navigationFailure(page.NetworkCode)
+			task.Report("network_error", "warn", "browser navigation failed: "+failure.Code+"; queue retry follows")
+			return harvest, failure
+		}
+		if page.Action == "challenge" || page.Action == "blocked" {
+			task.Report("manual", "warn", "Google requires operator verification; finish in the retained browser and resume")
+			return harvest, ErrManualHandoff
+		}
+		if !acted && errInspect == nil {
+			var errAction error
+			switch page.Action {
+			case "email":
+				if !googleIdentityHost(page.URL) {
+					return harvest, errors.New("registerbot: refusing credentials outside Google identity origin")
+				}
+				errAction = session.TypeInto(acquireCtx, "#identifierId,input[name=identifier],input[type=email]", "email", task.Account.Email)
+				if errAction == nil {
+					errAction = session.ClickText(acquireCtx, "Next", "下一步", "继续")
+				}
+			case "password":
+				if !googleIdentityHost(page.URL) {
+					return harvest, errors.New("registerbot: refusing credentials outside Google identity origin")
+				}
+				errAction = session.TypeInto(acquireCtx, "input[type=password]", "password", task.Account.Password)
+				if errAction == nil {
+					errAction = session.ClickText(acquireCtx, "Next", "下一步", "继续")
+				}
+			case "choose_account":
+				errAction = session.ClickText(acquireCtx, task.Account.Email, "Use another account", "使用其他帐号", "使用其他账号")
+			case "consent":
+				_ = session.ScrollToEnd(acquireCtx)
+				errAction = session.ClickText(acquireCtx, "I understand", "我了解", "我知道了", "我明白了", "I agree", "我同意", "Allow", "允许", "Continue", "继续", "Accept", "接受", "Next", "下一步")
+			case "google":
+				errAction = session.ClickText(acquireCtx, "Continue with Google", "Sign in with Google", "使用 Google", "Google")
+			case "reveal":
+				errAction = session.ClickText(acquireCtx, "Show API key", "Show key", "Reveal", "显示", "查看密钥")
+			case "dashboard":
+				errAction = session.Navigate(acquireCtx, "https://freeaiapikey.com/dashboard")
+			default:
+				errAction = errors.New("waiting for page")
+			}
+			if errAction == nil {
+				acted = true
+				lastProgress = time.Now()
+			}
+			var networkError *NavigationError
+			if errors.As(errAction, &networkError) {
+				task.Report("network_error", "warn", "browser navigation failed: "+networkError.Code+"; queue retry follows")
+				return harvest, networkError
+			}
+		}
+		if time.Since(lastProgress) >= set.Browser.StepTimeout() {
+			task.Report("manual", "warn", "page did not advance; retained browser is ready for operator continuation")
+			return harvest, ErrManualHandoff
+		}
+		select {
+		case <-acquireCtx.Done():
+		case <-ticker.C:
+		}
+	}
+}
+
+func freeAIStageMessage(stage string) string {
+	switch stage {
+	case "email":
+		return "entering Google account"
+	case "password":
+		return "entering Google password"
+	case "choose_account":
+		return "selecting Google account"
+	case "consent":
+		return "confirming Google consent or Workspace terms"
+	case "google":
+		return "opening Google authorization"
+	case "key":
+		return "API key found; validation follows"
+	case "reveal":
+		return "revealing provider API key"
+	case "dashboard":
+		return "opening provider dashboard"
+	case "challenge":
+		return "additional verification requested"
+	case "blocked":
+		return "Google sign-in needs operator assistance"
+	case "invalid_credentials":
+		return "Google rejected credentials"
+	case "network_error":
+		return "browser network failure detected"
+	default:
+		return "waiting for registration page"
+	}
+}
+
+const freeAIInspectScript = `(function(){
+ var visible=function(e){if(!e)return false;var r=e.getBoundingClientRect();return r.width>1&&r.height>1&&getComputedStyle(e).visibility!=='hidden';};
+ var has=function(s){return Array.from(document.querySelectorAll(s)).some(visible);};
+ var bodyText=document.body?document.body.innerText:'';
+ var text=bodyText.toLowerCase();
+ var host=location.hostname, path=location.pathname, action='loading', key='', networkCode='';
+ var humanChallenge=has('iframe[src*="recaptcha"],input[name=totpPin],input[name=idvPin]')||text.includes('verify it’s you')||text.includes("verify it's you")||text.includes('2-step verification');
+ var networkMatch=bodyText.match(/\bERR_[A-Z_]+\b/);
+ var chromeError=location.protocol==='chrome-error:'||location.origin==='null'||has('#main-frame-error,.neterror');
+ var google=host==='accounts.google.com';
+ var free=host==='freeaiapikey.com'||host==='www.freeaiapikey.com';
+ if(chromeError&&networkMatch){action='network_error';networkCode=networkMatch[0];}
+ else if(google){
+  if(text.includes('wrong password')||text.includes('密码错误')||text.includes("couldn’t find your google account")||text.includes("couldn't find your google account")){action='invalid_credentials';}
+  else if(has('input[type=password]')){action='password';}
+  else if(has('#identifierId,input[name=identifier],input[type=email]')){action='email';}
+  else if(text.includes('this browser or app may not be secure')||text.includes('此浏览器或应用可能不安全')){action='blocked';}
+  else if(path.includes('/challenge/')||humanChallenge){action='challenge';}
+  else if(path.includes('speedbump')||path.includes('consent')||text.includes('i understand')||text.includes('我了解')||text.includes('我同意')||text.includes('wants access')||text.includes('sign in to')){action='consent';}
+  else if(text.includes('choose an account')||text.includes('选择帐号')||text.includes('选择账号')){action='choose_account';}
+  else if(Array.from(document.querySelectorAll('button,[role=button],input[type=submit]')).some(function(e){return visible(e)&&/^(continue|allow|i agree|next|继续|允许|我同意)$/i.test((e.innerText||e.value||'').trim());})){action='consent';}
+ } else if(free){
+  if(path.startsWith('/dashboard')){
+   var content=(document.body?document.body.innerText:'')+'\n'+Array.from(document.querySelectorAll('input,textarea')).map(function(e){return e.value||'';}).join('\n');
+   var match=content.match(/sk-[A-Za-z0-9_-]{16,}/);
+   if(!match){var scripts=Array.from(document.scripts).map(function(e){return e.textContent||'';}).join('\n');var assigned=scripts.match(/keyValue\s*=\s*["'](sk-[A-Za-z0-9_-]{16,})["']/);if(assigned)match=assigned;}
+   if(match){key=match[1]||match[0];action='key';}
+   else if(/show api key|show key|reveal|显示|查看密钥/.test(text)){action='reveal';}
+  } else if(/continue with google|sign in with google|使用 google/.test(text)){action='google';}
+  else if(path!=='/register'&&path!=='/login'){action='dashboard';}
+ }
+ return {url:location.href,action:action,key:key,network_code:networkCode,human_challenge:humanChallenge};
+})()`
diff --git a/internal/registerbot/freeai_test.go b/internal/registerbot/freeai_test.go
new file mode 100644
index 0000000..1bc229d
--- /dev/null
+++ b/internal/registerbot/freeai_test.go
@@ -0,0 +1,157 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/gorilla/websocket"
+)
+
+func newFreeAITestCDP(t *testing.T, respond func(cdpMessage) map[string]any) *cdpClient {
+	t.Helper()
+	upgrader := websocket.Upgrader{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, errUpgrade := upgrader.Upgrade(w, r, nil)
+		if errUpgrade != nil {
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		for {
+			_, raw, errRead := conn.ReadMessage()
+			if errRead != nil {
+				return
+			}
+			var request cdpMessage
+			if errDecode := json.Unmarshal(raw, &request); errDecode != nil {
+				t.Error(errDecode)
+				return
+			}
+			result := respond(request)
+			payload, errEncode := json.Marshal(map[string]any{"id": request.ID, "result": result})
+			if errEncode != nil {
+				t.Error(errEncode)
+				return
+			}
+			if errWrite := conn.WriteMessage(websocket.TextMessage, payload); errWrite != nil {
+				return
+			}
+		}
+	}))
+	t.Cleanup(server.Close)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	client, errDial := dialCDP(ctx, "ws"+strings.TrimPrefix(server.URL, "http"))
+	if errDial != nil {
+		t.Fatal(errDial)
+	}
+	t.Cleanup(func() { _ = client.Close() })
+	return client
+}
+
+func TestNavigateReportsCDPNetworkFailureImmediately(t *testing.T) {
+	client := newFreeAITestCDP(t, func(request cdpMessage) map[string]any {
+		if request.Method != "Page.navigate" {
+			t.Errorf("unexpected command after navigation failure: %s", request.Method)
+		}
+		return map[string]any{"errorText": "net::ERR_CONNECTION_RESET"}
+	})
+	session := &Session{client: client, sessionID: "test"}
+	errNavigate := session.Navigate(context.Background(), "https://freeaiapikey.com/register")
+	var networkError *NavigationError
+	if !errors.As(errNavigate, &networkError) || networkError.Code != "ERR_CONNECTION_RESET" {
+		t.Fatalf("navigation error=%v", errNavigate)
+	}
+	if errors.Is(errNavigate, ErrManualHandoff) {
+		t.Fatal("network failure became manual handoff")
+	}
+}
+
+func newFreeAITestTask(t *testing.T) *Task {
+	t.Helper()
+	bus, errBus := NewBus(t.TempDir(), 100)
+	if errBus != nil {
+		t.Fatal(errBus)
+	}
+	t.Cleanup(func() { _ = bus.Close() })
+	return &Task{Channel: DefaultFreeAIChannel(), Run: "test-run", RowID: "test-row", Account: Account{Email: "fixture@example.invalid", Password: "fixture-secret"}, bus: bus}
+}
+
+func TestFreeAIOpenNetworkFailureRetriesInsteadOfManual(t *testing.T) {
+	client := newFreeAITestCDP(t, func(request cdpMessage) map[string]any {
+		switch request.Method {
+		case "Target.createBrowserContext":
+			return map[string]any{"browserContextId": "context"}
+		case "Target.createTarget":
+			return map[string]any{"targetId": "target"}
+		case "Target.attachToTarget":
+			return map[string]any{"sessionId": "session"}
+		case "Runtime.evaluate":
+			return map[string]any{"result": map[string]any{"value": "complete"}}
+		case "Page.navigate":
+			return map[string]any{"errorText": "net::ERR_PROXY_CONNECTION_FAILED"}
+		default:
+			return map[string]any{}
+		}
+	})
+	task := newFreeAITestTask(t)
+	task.browser = &browserInstance{control: client}
+	_, errRun := NewFreeAIDriver(nil).Run(context.Background(), task)
+	var networkError *NavigationError
+	if !errors.As(errRun, &networkError) || networkError.Code != "ERR_PROXY_CONNECTION_FAILED" {
+		t.Fatalf("driver error=%v", errRun)
+	}
+	if errors.Is(errRun, ErrManualHandoff) || task.session != nil {
+		t.Fatal("network failure retained a manual page")
+	}
+}
+
+func TestFreeAIChromeInterstitialRetriesInsteadOfWaiting(t *testing.T) {
+	client := newFreeAITestCDP(t, func(request cdpMessage) map[string]any {
+		if request.Method == "Runtime.evaluate" {
+			return map[string]any{"result": map[string]any{"value": map[string]any{"url": "https://freeaiapikey.com/register", "action": "network_error", "network_code": "ERR_CONNECTION_RESET"}}}
+		}
+		return map[string]any{}
+	})
+	task := newFreeAITestTask(t)
+	task.session = &Session{client: client, sessionID: "session", targetID: "target", contextID: "context"}
+	_, errRun := NewFreeAIDriver(nil).Run(context.Background(), task)
+	var networkError *NavigationError
+	if !errors.As(errRun, &networkError) || networkError.Code != "ERR_CONNECTION_RESET" {
+		t.Fatalf("interstitial error=%v", errRun)
+	}
+	if task.session != nil {
+		t.Fatal("failed interstitial was retained instead of retried")
+	}
+}
+
+func TestFreeAIPasswordTransitionDoesNotTriggerHumanVerification(t *testing.T) {
+	for _, test := range []struct {
+		name, url string
+		human     bool
+		want      string
+	}{
+		{"password transition", "https://accounts.google.com/v3/signin/challenge/pwd", false, "loading"},
+		{"password captcha", "https://accounts.google.com/v3/signin/challenge/pwd", true, "challenge"},
+		{"totp challenge", "https://accounts.google.com/v3/signin/challenge/totp", false, "challenge"},
+		{"untrusted origin", "https://example.invalid/challenge/pwd", false, "challenge"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			page := normalizeFreeAIPage(freeAIPage{URL: test.url, Action: "challenge", HumanChallenge: test.human})
+			if page.Action != test.want {
+				t.Fatalf("action=%s want=%s", page.Action, test.want)
+			}
+		})
+	}
+}
+
+func TestNavigationFailureNeverExposesArbitraryBrowserText(t *testing.T) {
+	if failure := navigationFailure("https://example.invalid/?token=private-value"); failure.Code != "ERR_FAILED" || strings.Contains(failure.Error(), "private-value") {
+		t.Fatalf("unsafe error=%v", failure)
+	}
+}
diff --git a/internal/registerbot/gateway.go b/internal/registerbot/gateway.go
new file mode 100644
index 0000000..2e19e0c
--- /dev/null
+++ b/internal/registerbot/gateway.go
@@ -0,0 +1,770 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+)
+
+// Gateway is the unified gateway layer above the registration channels.
+//
+// It talks to the operator's local proxy (default http://127.0.0.1:12450) on two
+// planes:
+//   - the forwarding plane, used as the HTTP proxy for browsers and API checks;
+//   - the control plane, a Clash compatible controller used to list groups and
+//     pin one node so different channels register from different exit IPs.
+//
+// The control plane is optional by design. When it is unreachable the gateway
+// degrades to proxy_only and the batch continues on one shared exit; when the
+// forwarding plane is also down it degrades to disabled and the batch continues
+// directly, because registering accounts matters more than node isolation.
+type Gateway struct {
+	settings func() Settings
+
+	mu            sync.Mutex
+	proxyClient   *http.Client
+	leaseChanged  chan struct{}
+	rotation      map[string]int
+	controllerURL string
+	controllerAt  time.Time
+	mode          string
+	lastError     string
+	checkedAt     time.Time
+	lastStatus    Status
+	groups        map[string]Group
+	leases        map[string]lease  // group|node -> holder
+	pinState      map[string]string // group -> node pinned by this process
+}
+
+type lease struct {
+	channel string
+	at      time.Time
+}
+
+// NewGateway builds the gateway layer. settingsFunc must return the live settings.
+func NewGateway(settingsFunc func() Settings) *Gateway {
+	return &Gateway{
+		settings:     settingsFunc,
+		mode:         GatewayModeDisabled,
+		groups:       make(map[string]Group),
+		leases:       make(map[string]lease),
+		pinState:     make(map[string]string),
+		leaseChanged: make(chan struct{}),
+		rotation:     make(map[string]int),
+		proxyClient: &http.Client{
+			Transport: &http.Transport{
+				DialContext:         (&net.Dialer{Timeout: 10 * time.Second}).DialContext,
+				MaxIdleConnsPerHost: 8,
+			},
+		},
+	}
+}
+
+// Group is one controller proxy group and its selectable nodes.
+type Group struct {
+	Name  string   `json:"name"`
+	Type  string   `json:"type"`
+	Now   string   `json:"now"`
+	Nodes []string `json:"nodes"`
+}
+
+// Status is the gateway view exposed to the panel.
+type Status struct {
+	Mode          string   `json:"mode"`
+	ProxyURL      string   `json:"proxy_url"`
+	ControllerURL string   `json:"controller_url,omitempty"`
+	ShareMode     string   `json:"share_mode"`
+	ExitIP        string   `json:"exit_ip,omitempty"`
+	Groups        []Group  `json:"groups"`
+	Selected      []string `json:"selected"`
+	Warnings      []string `json:"warnings,omitempty"`
+	Error         string   `json:"error,omitempty"`
+	CheckedAt     int64    `json:"checked_at"`
+}
+
+// snapshotSettings returns live settings or defaults when the callback is missing.
+func (g *Gateway) snapshotSettings() Settings {
+	if g == nil || g.settings == nil {
+		return DefaultSettings()
+	}
+	return g.settings()
+}
+
+// Mode reports the current degradation level of the gateway.
+func (g *Gateway) Mode() string {
+	if g == nil {
+		return GatewayModeDisabled
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.mode
+}
+
+// ProxyURL returns the forwarding address used by browsers and API checks.
+func (g *Gateway) ProxyURL() string {
+	set := g.snapshotSettings()
+	if strings.TrimSpace(set.Gateway.ProxyURL) == "" {
+		return DefaultSettings().Gateway.ProxyURL
+	}
+	return strings.TrimSpace(set.Gateway.ProxyURL)
+}
+
+// setTransport points the shared client at the current forwarding plane.
+func (g *Gateway) applyProxy(proxyURL string) error {
+	client, errClient := gatewayHTTPClient(proxyURL)
+	if errClient != nil {
+		return errClient
+	}
+	g.mu.Lock()
+	previous := g.proxyClient
+	g.proxyClient = client
+	g.mu.Unlock()
+	if previous != nil {
+		previous.CloseIdleConnections()
+	}
+	return nil
+}
+
+func gatewayHTTPClient(proxyURL string) (*http.Client, error) {
+	transport := &http.Transport{DialContext: (&net.Dialer{Timeout: 8 * time.Second}).DialContext, MaxIdleConnsPerHost: 8}
+	if proxyURL != "" {
+		parsed, errParse := url.Parse(proxyURL)
+		if errParse != nil || parsed.Host == "" || (parsed.Scheme != "http" && parsed.Scheme != "https") {
+			return nil, errors.New("registerbot: invalid HTTP proxy URL")
+		}
+		transport.Proxy = http.ProxyURL(parsed)
+	}
+	return &http.Client{Transport: transport}, nil
+}
+
+// EffectiveProxyURL is empty only when the forwarding plane is unavailable.
+func (g *Gateway) EffectiveProxyURL() string {
+	if g.Mode() == GatewayModeDisabled {
+		return ""
+	}
+	return g.ProxyURL()
+}
+
+// controllerClient builds a client that never chains through the proxy itself.
+func (g *Gateway) controllerClient() *http.Client {
+	return &http.Client{
+		Transport: &http.Transport{
+			Proxy:               nil,
+			DialContext:         (&net.Dialer{Timeout: 3 * time.Second}).DialContext,
+			MaxIdleConnsPerHost: 2,
+		},
+	}
+}
+
+func (g *Gateway) controllerSecret() string {
+	return strings.TrimSpace(g.snapshotSettings().Gateway.Secret)
+}
+
+// controllerGet issues a GET on the control plane.
+func (g *Gateway) controllerGet(ctx context.Context, baseURL, path string, out any) error {
+	req, errNew := http.NewRequestWithContext(ctx, http.MethodGet, baseURL+path, nil)
+	if errNew != nil {
+		return errNew
+	}
+	if secret := g.controllerSecret(); secret != "" {
+		req.Header.Set("Authorization", "Bearer "+secret)
+	}
+	resp, errDo := g.controllerClient().Do(req)
+	if errDo != nil {
+		return errDo
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			// Body close failures are not actionable here.
+			_ = errClose
+		}
+	}()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("registerbot: controller %s -> HTTP %d", path, resp.StatusCode)
+	}
+	if out == nil {
+		return nil
+	}
+	dec := json.NewDecoder(resp.Body)
+	return dec.Decode(out)
+}
+
+// candidateControllers derives control-plane addresses from the forwarding plane.
+func candidateControllers(proxyURL string, explicit string) []string {
+	var out []string
+	add := func(raw string) {
+		raw = strings.TrimSpace(raw)
+		if raw == "" {
+			return
+		}
+		if !strings.Contains(raw, "://") {
+			raw = "http://" + raw
+		}
+		for _, existing := range out {
+			if strings.EqualFold(existing, raw) {
+				return
+			}
+		}
+		out = append(out, raw)
+	}
+	add(explicit)
+	parsed, errParse := url.Parse(strings.TrimSpace(proxyURL))
+	if errParse != nil || parsed.Host == "" {
+		return out
+	}
+	host := parsed.Hostname()
+	port, errPort := net.LookupPort("tcp", parsed.Port())
+	if errPort != nil {
+		return out
+	}
+	// SakuraCat style launchers keep the controller next to the mixed port.
+	for _, delta := range []int{-10, -2, -1, 1, 2, 10} {
+		candidate := port + delta
+		if candidate <= 0 || candidate > 65535 {
+			continue
+		}
+		add(net.JoinHostPort(host, fmt.Sprint(candidate)))
+	}
+	for _, known := range []int{9090, 9097, 8888, 8080} {
+		add(net.JoinHostPort(host, fmt.Sprint(known)))
+	}
+	return out
+}
+
+// discoverController probes candidates and caches the first live control plane.
+func (g *Gateway) discoverController(ctx context.Context, force bool) (string, error) {
+	g.mu.Lock()
+	cached, cachedAt := g.controllerURL, g.controllerAt
+	g.mu.Unlock()
+	set := g.snapshotSettings()
+	if !force && cached != "" && time.Since(cachedAt) < time.Minute {
+		return cached, nil
+	}
+	var lastErr error
+	for _, candidate := range candidateControllers(g.ProxyURL(), set.Gateway.ControllerURL) {
+		var version struct {
+			Version string `json:"version"`
+		}
+		probeCtx, cancel := context.WithTimeout(ctx, set.Gateway.ProbeTimeout())
+		errProbe := g.controllerGet(probeCtx, candidate, "/version", &version)
+		cancel()
+		if errProbe != nil {
+			lastErr = errProbe
+			continue
+		}
+		if strings.TrimSpace(version.Version) == "" {
+			lastErr = fmt.Errorf("registerbot: controller %s reported no version", candidate)
+			continue
+		}
+		g.mu.Lock()
+		g.controllerURL = candidate
+		g.controllerAt = time.Now()
+		g.mu.Unlock()
+		return candidate, nil
+	}
+	if lastErr == nil {
+		lastErr = errors.New("registerbot: no controller candidate configured")
+	}
+	return "", lastErr
+}
+
+// Probe refreshes the gateway view and picks the highest usable mode.
+func (g *Gateway) Probe(ctx context.Context, force bool) Status {
+	set := g.snapshotSettings()
+	status := Status{ProxyURL: g.ProxyURL(), ShareMode: set.Gateway.ShareMode, Mode: GatewayModeDisabled, CheckedAt: time.Now().UnixMilli(), Groups: []Group{}, Selected: []string{}}
+	forwarding := g.pingProxy(status.ProxyURL) == nil
+	if forwarding {
+		status.Mode = GatewayModeProxyOnly
+	} else {
+		status.Warnings = append(status.Warnings, "forwarding plane unreachable; direct browser mode")
+	}
+	if ctrl, errDiscover := g.discoverController(ctx, force); errDiscover == nil {
+		status.ControllerURL = ctrl
+		if groups, errList := g.listGroups(ctx, ctrl); errList == nil {
+			status.Groups = groups
+			if forwarding {
+				status.Mode = GatewayModeController
+			}
+			g.mu.Lock()
+			g.groups = make(map[string]Group, len(groups))
+			for _, group := range groups {
+				g.groups[group.Name] = group
+				if group.Now != "" {
+					status.Selected = append(status.Selected, group.Name+"="+group.Now)
+				}
+			}
+			g.mu.Unlock()
+		} else {
+			status.Error = "controller proxy list unavailable"
+		}
+	} else {
+		status.Error = "controller unavailable"
+	}
+	if status.Mode != GatewayModeController {
+		status.Warnings = append(status.Warnings, "node isolation unavailable; batch continues with degraded routing")
+	}
+	if set.Gateway.VerifyExitIP && forwarding {
+		if ip, errIP := g.ExitIP(ctx); errIP == nil {
+			status.ExitIP = ip
+		} else {
+			status.Warnings = append(status.Warnings, "exit address could not be verified")
+		}
+	}
+	g.mu.Lock()
+	g.mode = status.Mode
+	g.lastError = status.Error
+	g.checkedAt = time.UnixMilli(status.CheckedAt)
+	g.lastStatus = status
+	g.mu.Unlock()
+	return status
+}
+
+// Snapshot returns the last measured gateway state without network probes.
+func (g *Gateway) Snapshot() Status {
+	set := g.snapshotSettings()
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	status := g.lastStatus
+	status.Mode = g.mode
+	status.ControllerURL = g.controllerURL
+	status.Groups = make([]Group, 0, len(g.groups))
+	for _, group := range g.groups {
+		group.Nodes = append([]string(nil), group.Nodes...)
+		status.Groups = append(status.Groups, group)
+	}
+	sortGroups(status.Groups)
+	status.Warnings = append([]string(nil), status.Warnings...)
+	status.Selected = append([]string(nil), status.Selected...)
+	if status.ShareMode == "" {
+		status.ShareMode = set.Gateway.ShareMode
+	}
+	if status.ProxyURL == "" {
+		status.ProxyURL = set.Gateway.ProxyURL
+	}
+	return status
+}
+
+type proxiesDocument struct {
+	Proxies map[string]struct {
+		Name    string   `json:"name"`
+		Type    string   `json:"type"`
+		Now     string   `json:"now"`
+		All     []string `json:"all"`
+		History []struct {
+			Delay int    `json:"delay"`
+			Time  string `json:"time"`
+		} `json:"history"`
+	} `json:"proxies"`
+}
+
+// listGroups reads selectable groups, ordered as the controller reports them.
+func (g *Gateway) listGroups(ctx context.Context, baseURL string) ([]Group, error) {
+	var doc proxiesDocument
+	if errGet := g.controllerGet(ctx, baseURL, "/proxies", &doc); errGet != nil {
+		return nil, errGet
+	}
+	set := g.snapshotSettings()
+	allowed := func(name string) bool {
+		if len(set.Gateway.Groups) == 0 {
+			return true
+		}
+		for _, want := range set.Gateway.Groups {
+			if strings.EqualFold(strings.TrimSpace(want), name) {
+				return true
+			}
+		}
+		return false
+	}
+	var out []Group
+	for name, item := range doc.Proxies {
+		if !allowed(name) {
+			continue
+		}
+		switch item.Type {
+		case "Selector", "selector":
+		default:
+			continue
+		}
+		nodes := make([]string, 0, len(item.All))
+		for _, node := range item.All {
+			leaf := doc.Proxies[node]
+			switch strings.ToLower(leaf.Type) {
+			case "selector", "urltest", "fallback", "direct", "reject":
+				continue
+			}
+			if strings.EqualFold(node, "DIRECT") || strings.EqualFold(node, "REJECT") {
+				continue
+			}
+			nodes = append(nodes, node)
+		}
+		grp := Group{Name: name, Type: item.Type, Now: item.Now, Nodes: nodes}
+		if grp.Now == "" {
+			grp.Now = item.Now
+		}
+		out = append(out, grp)
+	}
+	// Stable order keeps the panel list from reshuffling between polls.
+	sortGroups(out)
+	return out, nil
+}
+
+func sortGroups(groups []Group) {
+	for i := 1; i < len(groups); i++ {
+		for j := i; j > 0 && groups[j].Name < groups[j-1].Name; j-- {
+			groups[j], groups[j-1] = groups[j-1], groups[j]
+		}
+	}
+}
+
+// Groups returns the last probed group table without touching the network.
+func (g *Gateway) Groups() []Group {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	out := make([]Group, 0, len(g.groups))
+	for _, grp := range g.groups {
+		out = append(out, grp)
+	}
+	sortGroups(out)
+	return out
+}
+
+// pinNode switches one group to a node on the control plane.
+func (g *Gateway) pinNode(ctx context.Context, baseURL, group, node string) error {
+	payload, errMarshal := json.Marshal(map[string]string{"name": node})
+	if errMarshal != nil {
+		return fmt.Errorf("registerbot: encode pin payload: %w", errMarshal)
+	}
+	req, errNew := http.NewRequestWithContext(ctx, http.MethodPut, baseURL+"/proxies/"+url.PathEscape(group), strings.NewReader(string(payload)))
+	if errNew != nil {
+		return errNew
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if secret := g.controllerSecret(); secret != "" {
+		req.Header.Set("Authorization", "Bearer "+secret)
+	}
+	resp, errDo := g.controllerClient().Do(req)
+	if errDo != nil {
+		return errDo
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			_ = errClose
+		}
+	}()
+	// Clash replies 204 on success; sing-box may reply 200 with an empty body.
+	if resp.StatusCode != http.StatusNoContent && resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("registerbot: pin %s -> %s failed (HTTP %d)", group, node, resp.StatusCode)
+	}
+	g.mu.Lock()
+	g.pinState[group] = node
+	g.mu.Unlock()
+	return nil
+}
+
+// PinResult describes one completed node pin.
+type PinResult struct {
+	Group     string `json:"group"`
+	Node      string `json:"node"`
+	ExitIP    string `json:"exit_ip,omitempty"`
+	Mode      string `json:"mode"`
+	Changed   bool   `json:"changed"`
+	Verified  bool   `json:"verified"`
+	Degraded  string `json:"degraded,omitempty"`
+	ElapsedMS int64  `json:"elapsed_ms"`
+}
+
+// Pin makes group show node, then optionally confirms the observable exit changed.
+//
+// Node acquisition happens inside the credential acquisition window, so the pin
+// is bounded by Gateway.PinTimeout.
+func (g *Gateway) Pin(ctx context.Context, group, node string) (PinResult, error) {
+	started := time.Now()
+	set := g.snapshotSettings()
+	result := PinResult{Group: group, Node: node, Mode: g.Mode()}
+	if strings.TrimSpace(group) == "" || strings.TrimSpace(node) == "" {
+		return result, errors.New("registerbot: group and node are required")
+	}
+	if result.Mode != GatewayModeController {
+		result.Node = ""
+		result.Degraded = "control plane unavailable; pin skipped"
+		return result, nil
+	}
+	g.mu.Lock()
+	previous := g.pinState[group]
+	known := g.groups[group]
+	g.mu.Unlock()
+	if !containsNode(known.Nodes, node) {
+		return result, errors.New("registerbot: node does not belong to the selected group")
+	}
+	pinCtx, cancel := context.WithTimeout(ctx, set.Gateway.PinTimeout())
+	defer cancel()
+	baseURL, errDiscover := g.discoverController(pinCtx, false)
+	if errDiscover != nil {
+		result.Mode = GatewayModeProxyOnly
+		result.Node = ""
+		result.Degraded = "controller lost; continuing with proxy"
+		return result, nil
+	}
+	if errPin := g.pinNode(pinCtx, baseURL, group, node); errPin != nil {
+		result.Mode = GatewayModeProxyOnly
+		result.Node = ""
+		result.Degraded = "node pin rejected; continuing with proxy"
+		result.ElapsedMS = time.Since(started).Milliseconds()
+		return result, nil
+	}
+	result.Changed = previous != node
+	groups, errList := g.listGroups(pinCtx, baseURL)
+	if errList == nil {
+		for _, selected := range groups {
+			if selected.Name == group {
+				result.Verified = selected.Now == node
+			}
+		}
+	}
+	if !result.Verified {
+		result.Degraded = "controller did not confirm the selected node"
+	}
+	if set.Gateway.VerifyExitIP {
+		if ip, errIP := g.ExitIP(pinCtx); errIP == nil {
+			result.ExitIP = ip
+		} else {
+			result.Degraded = "node selected; exit address unverified"
+		}
+	}
+	result.ElapsedMS = time.Since(started).Milliseconds()
+	return result, nil
+}
+
+// NodePool resolves the nodes a channel may rotate over.
+func (g *Gateway) NodePool(channel ChannelSettings) []string {
+	g.mu.Lock()
+	grp, ok := g.groups[channel.Group]
+	g.mu.Unlock()
+	pool := append([]string(nil), channel.Nodes...)
+	if len(pool) == 0 && ok {
+		pool = append(pool, grp.Nodes...)
+	}
+	if len(pool) == 0 {
+		return nil
+	}
+	var out []string
+	for _, node := range pool {
+		node = strings.TrimSpace(node)
+		if node == "" {
+			continue
+		}
+		if ok && !containsNode(grp.Nodes, node) {
+			continue
+		}
+		out = append(out, node)
+	}
+	return out
+}
+
+func containsNode(nodes []string, want string) bool {
+	for _, node := range nodes {
+		if node == want {
+			return true
+		}
+	}
+	return false
+}
+
+// Acquire pins a node for a channel, honouring the configured share mode.
+//
+// lease: one node per channel at a time, serialised per group.
+// per_channel: every channel keeps its own group, no contention.
+// shared: all channels accept the same pinned node.
+func (g *Gateway) Acquire(ctx context.Context, channel ChannelSettings, holder string) (PinResult, error) {
+	set := g.snapshotSettings()
+	if channel.ManualMode || !set.Enabled {
+		return PinResult{Mode: g.Mode(), Degraded: "gateway skipped by channel settings"}, nil
+	}
+	// A single forwarding port cannot promise simultaneous per-channel exits.
+	// Hold an exclusive selector lease for the complete credential transaction.
+	key := channel.Group + "|" + holder
+	for {
+		g.mu.Lock()
+		if len(g.leases) == 0 {
+			g.leases[key] = lease{channel: channel.ID, at: time.Now()}
+			g.mu.Unlock()
+			break
+		}
+		changed := g.leaseChanged
+		g.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return PinResult{}, ctx.Err()
+		case <-changed:
+		}
+	}
+	if g.Mode() != GatewayModeController {
+		return PinResult{Mode: g.Mode(), Degraded: "controller unavailable; no exclusive exit guarantee"}, nil
+	}
+	pool := g.NodePool(channel)
+	if len(pool) == 0 {
+		return PinResult{Group: channel.Group, Mode: g.Mode(), Degraded: "no selectable nodes; current proxy route retained"}, nil
+	}
+	g.mu.Lock()
+	index := g.rotation[channel.ID]
+	chosen := pool[index%len(pool)]
+	if channel.RotateNode {
+		g.rotation[channel.ID] = index + 1
+	}
+	g.mu.Unlock()
+	result, errPin := g.Pin(ctx, channel.Group, chosen)
+	if errPin != nil {
+		g.Release(channel.Group, holder)
+	}
+	return result, errPin
+}
+
+// Release keeps the selected exit stable until every operation of the task ends.
+func (g *Gateway) Release(group, holder string) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	key := group + "|" + holder
+	if _, exists := g.leases[key]; exists {
+		delete(g.leases, key)
+		close(g.leaseChanged)
+		g.leaseChanged = make(chan struct{})
+	}
+}
+
+// exitIPDirect reads the local exit address without the forwarding plane.
+func (g *Gateway) exitIPDirect(ctx context.Context) (string, error) {
+	direct := &http.Client{
+		Transport: &http.Transport{
+			Proxy:       nil,
+			DialContext: (&net.Dialer{Timeout: 8 * time.Second}).DialContext,
+		},
+	}
+	return g.readExitIP(ctx, direct)
+}
+
+// ExitIP reads the exit address the forwarding plane currently presents.
+func (g *Gateway) ExitIP(ctx context.Context) (string, error) {
+	set := g.snapshotSettings()
+	client, errClient := gatewayHTTPClient(g.ProxyURL())
+	if errClient != nil {
+		return "", errClient
+	}
+	defer client.CloseIdleConnections()
+	probeCtx, cancel := context.WithTimeout(ctx, set.Gateway.ProbeTimeout()+5*time.Second)
+	defer cancel()
+	return g.readExitIP(probeCtx, client)
+}
+
+// pingProxy confirms a TCP session to the forwarding plane.
+func (g *Gateway) pingProxy(proxyURL string) error {
+	parsed, errParse := url.Parse(strings.TrimSpace(proxyURL))
+	if errParse != nil {
+		return errParse
+	}
+	port := parsed.Port()
+	if port == "" {
+		port = "80"
+	}
+	conn, errDial := net.DialTimeout("tcp", net.JoinHostPort(parsed.Hostname(), port), 3*time.Second)
+	if errDial != nil {
+		return errDial
+	}
+	defer func() {
+		if errClose := conn.Close(); errClose != nil {
+			_ = errClose
+		}
+	}()
+	return nil
+}
+
+func (g *Gateway) readExitIP(ctx context.Context, client *http.Client) (string, error) {
+	set := g.snapshotSettings()
+	target := strings.TrimSpace(set.Gateway.ExitIPURL)
+	if target == "" {
+		return "", errors.New("registerbot: exit ip probe url not configured")
+	}
+	req, errNew := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if errNew != nil {
+		return "", errNew
+	}
+	req.Header.Set("User-Agent", "cpa-registerbot/1.0")
+	resp, errDo := client.Do(req)
+	if errDo != nil {
+		return "", errDo
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			_ = errClose
+		}
+	}()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("registerbot: exit ip probe HTTP %d", resp.StatusCode)
+	}
+	var body strings.Builder
+	buf := make([]byte, 512)
+	for {
+		n, errRead := resp.Body.Read(buf)
+		if n > 0 {
+			_, _ = body.Write(buf[:n])
+		}
+		if errRead != nil {
+			break
+		}
+		if body.Len() > 4096 {
+			break
+		}
+	}
+	raw := strings.TrimSpace(body.String())
+	if raw == "" {
+		return "", errors.New("registerbot: exit ip probe returned no body")
+	}
+	var doc map[string]any
+	if errUnmarshal := json.Unmarshal([]byte(raw), &doc); errUnmarshal == nil {
+		for _, field := range []string{"ip", "query", "Ip", "IP", "origin"} {
+			if value, ok := doc[field]; ok {
+				if text, okString := value.(string); okString && strings.TrimSpace(text) != "" {
+					return strings.TrimSpace(text), nil
+				}
+			}
+		}
+	}
+	// Plain text services such as ifconfig.me return a bare address.
+	if fields := strings.Fields(raw); len(fields) == 1 {
+		return fields[0], nil
+	}
+	return "", errors.New("registerbot: exit ip probe body not recognised")
+}
+
+// HealthReport is the machine-readable gateway health for the panel header.
+type HealthReport struct {
+	OK      bool   `json:"ok"`
+	Level   string `json:"level"`
+	Message string `json:"message,omitempty"`
+}
+
+// Health summarises the gateway state for degradation banners.
+func (g *Gateway) Health() HealthReport {
+	g.mu.Lock()
+	mode, errText := g.mode, g.lastError
+	g.mu.Unlock()
+	switch mode {
+	case GatewayModeController:
+		return HealthReport{OK: true, Level: "full"}
+	case GatewayModeProxyOnly:
+		return HealthReport{OK: true, Level: "degraded", Message: "node pin disabled: " + errText}
+	default:
+		message := errText
+		if message == "" {
+			message = "gateway unavailable"
+		}
+		return HealthReport{OK: true, Level: "fallback", Message: message}
+	}
+}
