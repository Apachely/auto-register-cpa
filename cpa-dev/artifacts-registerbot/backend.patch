diff --git a/internal/api/handlers/management/registerbot.go b/internal/api/handlers/management/registerbot.go
new file mode 100644
index 0000000..423f321
--- /dev/null
+++ b/internal/api/handlers/management/registerbot.go
@@ -0,0 +1,280 @@
+package management
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registerbot"
+	log "github.com/sirupsen/logrus"
+)
+
+// The engine is initialized on first use; ordinary CPA startup does not launch Chrome.
+func (h *Handler) registerBotEngine() (*registerbot.Engine, error) {
+	h.registerBotMu.Lock()
+	defer h.registerBotMu.Unlock()
+	if h.registerBotClosed {
+		return nil, errors.New("registerbot: server is stopping")
+	}
+	if h.registerBot != nil {
+		return h.registerBot, nil
+	}
+	if h.configFilePath == "" {
+		return nil, errors.New("registerbot: config file is required")
+	}
+	dir := filepath.Join(filepath.Dir(h.configFilePath), "registerbot")
+	settings := registerbot.DefaultSettings()
+	settings.StateDir = dir
+	engine, errNew := registerbot.NewEngine(dir, settings, h.importRegisterBotKey)
+	if errNew != nil {
+		return nil, errNew
+	}
+	h.registerBot = engine
+	return engine, nil
+}
+
+// CloseRegisterBot releases owned workers and browsers during server shutdown.
+func (h *Handler) CloseRegisterBot() error {
+	h.registerBotMu.Lock()
+	h.registerBotClosed = true
+	engine := h.registerBot
+	h.registerBotMu.Unlock()
+	if engine != nil {
+		return engine.Close()
+	}
+	return nil
+}
+
+func (h *Handler) requireRegisterBot(c *gin.Context) *registerbot.Engine {
+	c.Header("Cache-Control", "no-store")
+	engine, errInit := h.registerBotEngine()
+	if errInit != nil {
+		log.WithField("component", "registerbot").Warn("registration engine initialization failed")
+		registerBotError(c, http.StatusServiceUnavailable, "engine_unavailable")
+		return nil
+	}
+	return engine
+}
+
+func registerBotError(c *gin.Context, status int, code string) {
+	c.JSON(status, gin.H{"error": gin.H{"code": code, "message": code}})
+}
+
+func decodeRegisterBot(c *gin.Context, dst any) bool {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 300*1024)
+	decoder := json.NewDecoder(c.Request.Body)
+	if errDecode := decoder.Decode(dst); errDecode != nil {
+		registerBotError(c, http.StatusBadRequest, "invalid_request")
+		return false
+	}
+	var extra any
+	if errTrailing := decoder.Decode(&extra); errTrailing != io.EOF {
+		registerBotError(c, http.StatusBadRequest, "invalid_request")
+		return false
+	}
+	return true
+}
+
+func (h *Handler) GetRegisterBot(c *gin.Context) {
+	if engine := h.requireRegisterBot(c); engine != nil {
+		c.JSON(http.StatusOK, engine.Snapshot())
+	}
+}
+
+func (h *Handler) GetRegisterBotChannels(c *gin.Context) {
+	if engine := h.requireRegisterBot(c); engine != nil {
+		c.JSON(http.StatusOK, gin.H{"channels": engine.Settings().Channels})
+	}
+}
+
+func (h *Handler) PutRegisterBotChannel(c *gin.Context) {
+	engine := h.requireRegisterBot(c)
+	if engine == nil {
+		return
+	}
+	var channel registerbot.ChannelSettings
+	if !decodeRegisterBot(c, &channel) {
+		return
+	}
+	if channel.ID != c.Param("id") || channel.ID == "" {
+		registerBotError(c, http.StatusBadRequest, "channel_mismatch")
+		return
+	}
+	settings := engine.Settings()
+	found := false
+	for i := range settings.Channels {
+		if settings.Channels[i].ID == channel.ID {
+			settings.Channels[i] = channel
+			found = true
+			break
+		}
+	}
+	if !found {
+		if len(settings.Channels) >= 32 {
+			registerBotError(c, http.StatusBadRequest, "channel_limit")
+			return
+		}
+		settings.Channels = append(settings.Channels, channel)
+	}
+	if errUpdate := engine.UpdateSettings(settings); errUpdate != nil {
+		registerBotError(c, http.StatusConflict, "settings_update_failed")
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"channels": engine.Settings().Channels})
+}
+
+func (h *Handler) StartRegisterBotRun(c *gin.Context) {
+	engine := h.requireRegisterBot(c)
+	if engine == nil {
+		return
+	}
+	var request registerbot.StartRequest
+	if !decodeRegisterBot(c, &request) {
+		return
+	}
+	run, errStart := engine.Start(request)
+	if errStart != nil {
+		registerBotError(c, http.StatusBadRequest, "run_rejected")
+		return
+	}
+	c.JSON(http.StatusAccepted, gin.H{"run": run})
+}
+
+func (h *Handler) RegisterBotAction(c *gin.Context) {
+	engine := h.requireRegisterBot(c)
+	if engine == nil {
+		return
+	}
+	var request struct {
+		Action string `json:"action"`
+	}
+	if !decodeRegisterBot(c, &request) {
+		return
+	}
+	if errAction := engine.Action(c.Param("run"), request.Action); errAction != nil {
+		registerBotError(c, http.StatusConflict, "action_rejected")
+		return
+	}
+	c.JSON(http.StatusOK, engine.Snapshot())
+}
+
+func (h *Handler) RegisterBotSubmitKey(c *gin.Context) {
+	engine := h.requireRegisterBot(c)
+	if engine == nil {
+		return
+	}
+	var request struct {
+		RowID string `json:"row_id"`
+		Key   string `json:"key"`
+	}
+	if !decodeRegisterBot(c, &request) {
+		return
+	}
+	if errSubmit := engine.SubmitKey(c.Param("run"), request.RowID, request.Key); errSubmit != nil {
+		registerBotError(c, http.StatusConflict, "key_rejected")
+		return
+	}
+	c.JSON(http.StatusAccepted, engine.Snapshot())
+}
+
+func (h *Handler) GetRegisterBotGateway(c *gin.Context) {
+	if engine := h.requireRegisterBot(c); engine != nil {
+		c.JSON(http.StatusOK, engine.Gateway().Snapshot())
+	}
+}
+
+func (h *Handler) ProbeRegisterBotGateway(c *gin.Context) {
+	if engine := h.requireRegisterBot(c); engine != nil {
+		status := engine.Gateway().Probe(c.Request.Context(), true)
+		engine.Events().Emit(registerbot.Event{Stage: "gateway_probe", Level: "info", Message: status.Mode})
+		c.JSON(http.StatusOK, status)
+	}
+}
+
+// RegisterBotEvents streams authenticated cursor replay without query-string credentials.
+func (h *Handler) RegisterBotEvents(c *gin.Context) {
+	engine := h.requireRegisterBot(c)
+	if engine == nil {
+		return
+	}
+	raw := c.Query("after")
+	if raw == "" {
+		raw = c.GetHeader("Last-Event-ID")
+	}
+	after := int64(0)
+	if raw != "" {
+		var errCursor error
+		after, errCursor = strconv.ParseInt(raw, 10, 64)
+		if errCursor != nil || after < 0 {
+			registerBotError(c, http.StatusBadRequest, "invalid_cursor")
+			return
+		}
+	}
+	channel := strings.TrimSpace(c.Query("channel"))
+	replay, live, cancel, reset := engine.Events().SubscribeAfter(after, channel, 128)
+	defer cancel()
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("X-Accel-Buffering", "no")
+	c.Status(http.StatusOK)
+	write := func(kind string, seq int64, value any) bool {
+		data, errMarshal := json.Marshal(value)
+		if errMarshal != nil {
+			return false
+		}
+		prefix := ""
+		if seq > 0 {
+			prefix = fmt.Sprintf("id: %d\n", seq)
+		}
+		if _, errWrite := fmt.Fprintf(c.Writer, "%sevent: %s\ndata: %s\n\n", prefix, kind, data); errWrite != nil {
+			return false
+		}
+		c.Writer.Flush()
+		return true
+	}
+	if reset {
+		after = 0
+		if !write("reset", 0, gin.H{"cursor": 0}) {
+			return
+		}
+	}
+	for _, event := range replay {
+		if !write("registerbot", event.Seq, event) {
+			return
+		}
+		after = event.Seq
+	}
+	if !write("ready", 0, gin.H{"cursor": after}) {
+		return
+	}
+	ticker := time.NewTicker(15 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-c.Request.Context().Done():
+			return
+		case event, open := <-live:
+			if !open {
+				return
+			}
+			if event.Seq <= after || (channel != "" && event.Channel != channel) {
+				continue
+			}
+			if !write("registerbot", event.Seq, event) {
+				return
+			}
+			after = event.Seq
+		case <-ticker.C:
+			if _, errWrite := io.WriteString(c.Writer, ": keepalive\n\n"); errWrite != nil {
+				return
+			}
+			c.Writer.Flush()
+		}
+	}
+}
diff --git a/internal/api/handlers/management/registerbot_import.go b/internal/api/handlers/management/registerbot_import.go
new file mode 100644
index 0000000..dd8ef4f
--- /dev/null
+++ b/internal/api/handlers/management/registerbot_import.go
@@ -0,0 +1,244 @@
+package management
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registerbot"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+)
+
+const registerBotProviderPath = "/v8/management/config/api-keys/openai-compatibility"
+
+type registerBotProvider struct {
+	Name    string `json:"name"`
+	BaseURL string `json:"base-url"`
+	Prefix  string `json:"prefix"`
+	Keys    []struct {
+		Key   string `json:"api-key"`
+		Proxy string `json:"proxy-url"`
+	} `json:"keys"`
+}
+
+// This adapter uses the exact v8 GET/PUT contract used by providerKeyImport.ts.
+// It dispatches privately to ConfigV8, preserving its validation, ETag/If-Match,
+// file CAS, auth-index stripping and runtime reload without a loopback secret.
+type registerBotConfigResponse struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func (r *registerBotConfigResponse) Header() http.Header { return r.header }
+func (r *registerBotConfigResponse) WriteHeader(status int) {
+	if r.status == 0 {
+		r.status = status
+	}
+}
+func (r *registerBotConfigResponse) Write(data []byte) (int, error) {
+	if r.status == 0 {
+		r.status = http.StatusOK
+	}
+	return r.body.Write(data)
+}
+
+func (h *Handler) registerBotConfigRequest(ctx context.Context, method string, body []byte, etag string) (*registerBotConfigResponse, error) {
+	req, errRequest := http.NewRequestWithContext(ctx, method, registerBotProviderPath, bytes.NewReader(body))
+	if errRequest != nil {
+		return nil, errors.New("registerbot: configuration request failed")
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if method != http.MethodGet {
+		req.Header.Set("If-Match", etag)
+	}
+	response := &registerBotConfigResponse{header: make(http.Header)}
+	router := gin.New()
+	router.Handle(method, "/v8/management/config/*path", func(c *gin.Context) {
+		c.Set(ConfigV8ContextKey, true)
+		h.ConfigV8(c)
+	})
+	router.ServeHTTP(response, req)
+	return response, nil
+}
+
+func registerBotImportPlan(source []byte, channel registerbot.ChannelSettings, key string) ([]byte, string, bool, error) {
+	var groups []registerBotProvider
+	if errDecode := json.Unmarshal(source, &groups); errDecode != nil {
+		return nil, "", false, errors.New("registerbot: provider configuration unavailable")
+	}
+	index := -1
+	for i, group := range groups {
+		if group.Name == channel.Provider {
+			if index >= 0 {
+				return nil, "", false, errors.New("registerbot: ambiguous provider destination")
+			}
+			index = i
+		}
+	}
+	if index < 0 {
+		return nil, "", false, errors.New("registerbot: provider destination missing")
+	}
+	group := groups[index]
+	base := strings.TrimRight(strings.TrimSpace(group.BaseURL), "/")
+	if base != "https://api.freeaiapikey.com/v1" {
+		return nil, "", false, errors.New("registerbot: provider destination changed")
+	}
+	if channel.ProxyURL == "" {
+		return nil, "", false, errors.New("registerbot: provider proxy missing")
+	}
+	for _, existing := range group.Keys {
+		if existing.Key == key {
+			if existing.Proxy != channel.ProxyURL {
+				return nil, "", false, errors.New("registerbot: provider proxy mismatch")
+			}
+			return nil, base + "/models", true, nil
+		}
+	}
+	doc := ojson.NewDoc(source)
+	path := fmt.Sprintf("%d.keys", index)
+	if group.Keys == nil {
+		if errSet := doc.Set(path, []any{}); errSet != nil {
+			return nil, "", false, errors.New("registerbot: invalid provider key collection")
+		}
+	}
+	if errSet := doc.Set(path+".-1", map[string]string{"api-key": key, "proxy-url": channel.ProxyURL}); errSet != nil {
+		return nil, "", false, errors.New("registerbot: provider key append failed")
+	}
+	return doc.Bytes(), base + "/models", false, nil
+}
+
+func validRegisterBotKey(key string) bool {
+	if !strings.HasPrefix(key, "sk-") || len(key) < 19 || len(key) > 512 {
+		return false
+	}
+	for _, r := range key[3:] {
+		if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '_' || r == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func verifyRegisterBotKey(ctx context.Context, endpoint, proxy, key string) error {
+	transport, _, errTransport := proxyutil.BuildHTTPTransport(proxy)
+	if errTransport != nil {
+		return errors.New("registerbot: key verification proxy invalid")
+	}
+	if transport == nil {
+		transport = proxyutil.NewDirectTransport()
+	}
+	defer transport.CloseIdleConnections()
+	// Only establishment is bounded; response headers and reads have no timeout.
+	if proxy == "direct" || strings.HasPrefix(proxy, "http://") || strings.HasPrefix(proxy, "https://") {
+		transport.DialContext = (&net.Dialer{Timeout: 10 * time.Second, KeepAlive: 30 * time.Second}).DialContext
+	}
+	transport.ResponseHeaderTimeout = 0
+	transport.TLSHandshakeTimeout = 0
+	client := &http.Client{Transport: transport, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	req, errRequest := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if errRequest != nil {
+		return errors.New("registerbot: invalid verification endpoint")
+	}
+	req.Header.Set("Authorization", "Bearer "+key)
+	req.Header.Set("Accept", "application/json")
+	response, errResponse := client.Do(req)
+	if errResponse != nil {
+		return errors.New("registerbot: key verification connection failed")
+	}
+	defer func() { _ = response.Body.Close() }()
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("registerbot: key verification HTTP %d", response.StatusCode)
+	}
+	data, errRead := io.ReadAll(io.LimitReader(response.Body, 4*1024*1024+1))
+	if errRead != nil || len(data) > 4*1024*1024 {
+		return errors.New("registerbot: key verification response invalid")
+	}
+	var models struct {
+		Data []struct {
+			ID string `json:"id"`
+		} `json:"data"`
+	}
+	if errDecode := json.Unmarshal(data, &models); errDecode != nil || len(models.Data) == 0 {
+		return errors.New("registerbot: key verification returned no models")
+	}
+	return nil
+}
+
+func (h *Handler) importRegisterBotKey(ctx context.Context, channel registerbot.ChannelSettings, harvest registerbot.Harvest) (resultErr error) {
+	defer func() {
+		if resultErr == nil {
+			return
+		}
+		if ctx.Err() != nil {
+			resultErr = ctx.Err()
+			return
+		}
+		reason := "write_failed"
+		switch {
+		case strings.Contains(resultErr.Error(), "verification"), strings.Contains(resultErr.Error(), "invalid harvested"):
+			reason = "verification_failed"
+		case strings.Contains(resultErr.Error(), "destination"), strings.Contains(resultErr.Error(), "proxy mismatch"):
+			reason = "provider_missing"
+		case strings.Contains(resultErr.Error(), "conflict"), strings.Contains(resultErr.Error(), "ETag"):
+			reason = "config_conflict"
+		}
+		resultErr = &registerbot.ImportError{Reason: reason}
+	}()
+	if !validRegisterBotKey(harvest.APIKey) {
+		return errors.New("registerbot: invalid harvested key")
+	}
+	snapshot, errRead := h.registerBotConfigRequest(ctx, http.MethodGet, nil, "")
+	if errRead != nil || snapshot.status != http.StatusOK {
+		return errors.New("registerbot: provider configuration unavailable")
+	}
+	etag := snapshot.header.Get("ETag")
+	if len(etag) != 66 || etag[0] != '"' || etag[65] != '"' {
+		return errors.New("registerbot: provider configuration ETag missing")
+	}
+	body, endpoint, present, errPlan := registerBotImportPlan(snapshot.body.Bytes(), channel, harvest.APIKey)
+	if errPlan != nil {
+		return errPlan
+	}
+	verificationProxy := harvest.VerificationProxyURL
+	if verificationProxy == "" {
+		verificationProxy = "direct"
+	}
+	if errVerify := verifyRegisterBotKey(ctx, endpoint, verificationProxy, harvest.APIKey); errVerify != nil {
+		return errVerify
+	}
+	if present {
+		return nil
+	}
+	if errContext := ctx.Err(); errContext != nil {
+		return errContext
+	}
+	response, errWrite := h.registerBotConfigRequest(ctx, http.MethodPut, body, etag)
+	if errWrite != nil {
+		return errors.New("registerbot: provider write unconfirmed")
+	}
+	if response.status == http.StatusConflict || response.status == http.StatusPreconditionFailed {
+		return errors.New("registerbot: provider configuration conflict; resume import")
+	}
+	if response.status != http.StatusOK {
+		return errors.New("registerbot: provider write rejected")
+	}
+	confirmation, errConfirm := h.registerBotConfigRequest(ctx, http.MethodGet, nil, "")
+	if errConfirm != nil || confirmation.status != http.StatusOK {
+		return errors.New("registerbot: provider readback failed")
+	}
+	_, _, confirmed, errPlan := registerBotImportPlan(confirmation.body.Bytes(), channel, harvest.APIKey)
+	if errPlan != nil || !confirmed {
+		return errors.New("registerbot: provider write unconfirmed")
+	}
+	return nil
+}
