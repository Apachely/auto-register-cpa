diff --git a/internal/registerbot/cdp.go b/internal/registerbot/cdp.go
new file mode 100644
index 0000000..b3a0c46
--- /dev/null
+++ b/internal/registerbot/cdp.go
@@ -0,0 +1,1066 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/json"
+	"github.com/gorilla/websocket"
+)
+
+// cdpClient is a minimal Chrome DevTools Protocol client.
+//
+// One websocket session drives the whole browser: flattened target sessions carry
+// a sessionId, so a single connection per pooled instance is enough. Keeping the
+// surface small means the registerbot adds no dependency beyond the websocket
+// client CPA already ships, and every CDP failure returns an error the engine can
+// degrade on instead of panicking.
+type cdpClient struct {
+	conn      *websocket.Conn
+	endpoint  string
+	mu        sync.Mutex
+	writeMu   sync.Mutex
+	nextID    int
+	pending   map[int]chan cdpMessage
+	closeOnce sync.Once
+	closed    chan struct{}
+	err       error
+	errMu     sync.Mutex
+
+	handlersMu      sync.Mutex
+	handlers        map[string][]cdpHandler
+	nextSubscribeID int
+}
+
+type cdpHandler struct {
+	// sessionID empty matches any session of a flattened target browser.
+	sessionID string
+	// token lets unsubscribe remove exactly this registration.
+	token string
+	call  func(cdpMessage)
+}
+
+type cdpMessage struct {
+	ID        int            `json:"id"`
+	Method    string         `json:"method"`
+	Params    map[string]any `json:"params"`
+	Result    map[string]any `json:"result"`
+	SessionID string         `json:"sessionId"`
+	Error     *cdpErrorBody  `json:"error"`
+}
+
+type cdpErrorBody struct {
+	Message string `json:"message"`
+	Code    int    `json:"code"`
+}
+
+// cdpError reports a protocol level failure.
+type cdpError struct {
+	Code    int
+	Message string
+}
+
+func (e cdpError) Error() string {
+	return fmt.Sprintf("cdp command failed (%d)", e.Code)
+}
+
+// dialCDP connects to a DevTools websocket endpoint.
+func dialCDP(ctx context.Context, wsURL string) (*cdpClient, error) {
+	dialer := websocket.Dialer{HandshakeTimeout: 10 * time.Second}
+	conn, resp, errDial := dialer.DialContext(ctx, wsURL, nil)
+	if errDial != nil {
+		return nil, fmt.Errorf("registerbot: cdp dial %s: %w", wsURL, errDial)
+	}
+	if resp != nil && resp.Body != nil {
+		_ = resp.Body.Close()
+	}
+	client := &cdpClient{
+		conn:     conn,
+		endpoint: wsURL,
+		nextID:   1,
+		pending:  make(map[int]chan cdpMessage),
+		closed:   make(chan struct{}),
+		handlers: make(map[string][]cdpHandler),
+	}
+	go client.readLoop()
+	return client, nil
+}
+
+func (c *cdpClient) setErr(err error) {
+	c.errMu.Lock()
+	if c.err == nil {
+		c.err = err
+	}
+	c.errMu.Unlock()
+}
+
+func (c *cdpClient) loadErr() error {
+	c.errMu.Lock()
+	defer c.errMu.Unlock()
+	return c.err
+}
+
+// readLoop dispatches command responses and target events.
+func (c *cdpClient) readLoop() {
+	defer c.closePending(errors.New("cdp connection closed"))
+	for {
+		_, payload, errRead := c.conn.ReadMessage()
+		if errRead != nil {
+			c.setErr(errRead)
+			return
+		}
+		var msg cdpMessage
+		if errDecode := json.Unmarshal(payload, &msg); errDecode != nil {
+			c.setErr(errors.New("invalid CDP message"))
+			return
+		}
+		if msg.ID != 0 {
+			c.mu.Lock()
+			ch, ok := c.pending[msg.ID]
+			if ok {
+				delete(c.pending, msg.ID)
+			}
+			c.mu.Unlock()
+			if ok {
+				ch <- msg
+			}
+			continue
+		}
+		if msg.Method == "" {
+			continue
+		}
+		c.handlersMu.Lock()
+		matched := make([]func(cdpMessage), 0, len(c.handlers[msg.Method]))
+		for _, handler := range c.handlers[msg.Method] {
+			if handler.sessionID == "" || handler.sessionID == msg.SessionID {
+				matched = append(matched, handler.call)
+			}
+		}
+		c.handlersMu.Unlock()
+		for _, call := range matched {
+			call(msg)
+		}
+	}
+}
+
+func (c *cdpClient) closePending(reason error) {
+	c.mu.Lock()
+	pending := c.pending
+	c.pending = make(map[int]chan cdpMessage)
+	c.mu.Unlock()
+	for _, ch := range pending {
+		select {
+		case ch <- cdpMessage{Error: &cdpErrorBody{Message: reason.Error(), Code: -1}}:
+		default:
+		}
+	}
+	c.closeOnce.Do(func() { close(c.closed) })
+}
+
+// subscribe registers a handler for one event method of one session.
+func (c *cdpClient) subscribe(method, sessionID string, call func(cdpMessage)) func() {
+	c.handlersMu.Lock()
+	token := fmt.Sprintf("%s#%d", method, c.nextSubscribeID)
+	c.nextSubscribeID++
+	c.handlers[method] = append(c.handlers[method], cdpHandler{sessionID: sessionID, token: token, call: call})
+	c.handlersMu.Unlock()
+	return func() {
+		c.handlersMu.Lock()
+		defer c.handlersMu.Unlock()
+		kept := make([]cdpHandler, 0, len(c.handlers[method]))
+		for _, existing := range c.handlers[method] {
+			if existing.token != token {
+				kept = append(kept, existing)
+			}
+		}
+		c.handlers[method] = kept
+	}
+}
+
+// Call sends one command with no session and waits for its response.
+func (c *cdpClient) Call(ctx context.Context, method string, params map[string]any) (map[string]any, error) {
+	return c.roundTrip(ctx, method, params, "")
+}
+
+// roundTrip performs one command, tagged with sessionId when provided.
+func (c *cdpClient) roundTrip(ctx context.Context, method string, params map[string]any, sessionID string) (map[string]any, error) {
+	if params == nil {
+		params = map[string]any{}
+	}
+	c.mu.Lock()
+	if errLoad := c.loadErr(); errLoad != nil {
+		c.mu.Unlock()
+		return nil, errLoad
+	}
+	id := c.nextID
+	c.nextID++
+	ch := make(chan cdpMessage, 1)
+	c.pending[id] = ch
+	envelope := map[string]any{"id": id, "method": method, "params": params}
+	if sessionID != "" {
+		envelope["sessionId"] = sessionID
+	}
+	payload, errMarshal := json.Marshal(envelope)
+	c.mu.Unlock()
+	if errMarshal != nil {
+		c.dropPending(id)
+		return nil, fmt.Errorf("registerbot: encode cdp call: %w", errMarshal)
+	}
+	c.writeMu.Lock()
+	errWrite := c.conn.WriteMessage(websocket.TextMessage, payload)
+	c.writeMu.Unlock()
+	if errWrite != nil {
+		c.dropPending(id)
+		return nil, fmt.Errorf("registerbot: cdp write: %w", errWrite)
+	}
+	select {
+	case <-ctx.Done():
+		c.dropPending(id)
+		return nil, c.wrapContextErr(ctx.Err())
+	case <-c.closed:
+		c.dropPending(id)
+		return nil, c.loadErr()
+	case msg := <-ch:
+		if msg.Error != nil {
+			return nil, cdpError{Code: msg.Error.Code, Message: msg.Error.Message}
+		}
+		return msg.Result, nil
+	}
+}
+
+func (c *cdpClient) dropPending(id int) {
+	c.mu.Lock()
+	delete(c.pending, id)
+	c.mu.Unlock()
+}
+
+// wrapContextErr keeps a cancelled run distinguishable from a dead socket.
+func (c *cdpClient) wrapContextErr(err error) error {
+	if err == nil {
+		return nil
+	}
+	if live := c.loadErr(); live != nil {
+		return live
+	}
+	return err
+}
+
+// Close ends the session.
+func (c *cdpClient) Close() error {
+	if c == nil {
+		return nil
+	}
+	errClose := c.conn.Close()
+	c.setErr(errors.New("cdp session closed"))
+	c.closePending(errors.New("cdp session closed"))
+	return errClose
+}
+
+// Session drives one page target inside a pooled browser instance.
+type Session struct {
+	client    *cdpClient
+	sessionID string
+	targetID  string
+	openerID  string
+	contextID string
+	instance  *browserInstance
+	closeOnce sync.Once
+}
+
+// call runs a command inside the flattened target session.
+func (s *Session) call(ctx context.Context, method string, params map[string]any) (map[string]any, error) {
+	if s == nil || s.client == nil {
+		return nil, errors.New("registerbot: session detached")
+	}
+	return s.client.roundTrip(ctx, method, params, s.sessionID)
+}
+
+// cdpTransport resolves the HTTP endpoints of a DevTools listener.
+type cdpTransport struct {
+	base   string
+	client *http.Client
+}
+
+func newCDPTransport(hostPort string) *cdpTransport {
+	if strings.TrimSpace(hostPort) == "" {
+		hostPort = "127.0.0.1:9333"
+	}
+	if strings.Contains(hostPort, "://") {
+		hostPort = strings.TrimPrefix(strings.TrimPrefix(hostPort, "http://"), "https://")
+	}
+	return &cdpTransport{
+		base: "http://" + hostPort,
+		client: &http.Client{
+			Transport: &http.Transport{
+				Proxy:               nil,
+				DialContext:         (&net.Dialer{Timeout: 5 * time.Second}).DialContext,
+				MaxIdleConnsPerHost: 4,
+			},
+		},
+	}
+}
+
+func (t *cdpTransport) getJSON(ctx context.Context, path string, out any) error {
+	req, errNew := http.NewRequestWithContext(ctx, http.MethodGet, t.base+path, nil)
+	if errNew != nil {
+		return errNew
+	}
+	resp, errDo := t.client.Do(req)
+	if errDo != nil {
+		return errDo
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			_ = errClose
+		}
+	}()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("registerbot: devtools %s -> HTTP %d", path, resp.StatusCode)
+	}
+	return json.NewDecoder(resp.Body).Decode(out)
+}
+
+// versionReady confirms a DevTools listener answered and reports the build.
+func (t *cdpTransport) versionReady(ctx context.Context) (string, error) {
+	var doc struct {
+		Browser         string `json:"Browser"`
+		ProtocolVersion string `json:"Protocol-Version"`
+	}
+	if errGet := t.getJSON(ctx, "/json/version", &doc); errGet != nil {
+		return "", errGet
+	}
+	if strings.TrimSpace(doc.ProtocolVersion) == "" {
+		return "", errors.New("registerbot: devtools endpoint answered without a protocol version")
+	}
+	return doc.Browser, nil
+}
+
+// connectBrowser opens the browser level session used for target management.
+func (t *cdpTransport) connectBrowser(ctx context.Context) (*cdpClient, error) {
+	var doc struct {
+		WebsocketURL string `json:"webSocketDebuggerUrl"`
+	}
+	if errGet := t.getJSON(ctx, "/json/version", &doc); errGet != nil {
+		return nil, errGet
+	}
+	if strings.TrimSpace(doc.WebsocketURL) == "" {
+		return nil, errors.New("registerbot: devtools endpoint has no browser websocket url")
+	}
+	return dialCDP(ctx, doc.WebsocketURL)
+}
+
+// OpenPage creates a fresh tab and returns a usable page session.
+func (b *browserInstance) OpenPage(ctx context.Context, initialURL string) (*Session, error) {
+	if b == nil || b.control == nil {
+		return nil, errors.New("registerbot: browser instance unavailable")
+	}
+	b.mu.Lock()
+	proxyURL := b.proxyURL
+	b.mu.Unlock()
+	if proxyURL == "" {
+		proxyURL = "direct://"
+	}
+	contextResult, errContext := b.control.Call(ctx, "Target.createBrowserContext", map[string]any{"disposeOnDetach": true, "proxyServer": proxyURL})
+	if errContext != nil {
+		return nil, fmt.Errorf("registerbot: isolated context: %w", errContext)
+	}
+	contextID, _ := contextResult["browserContextId"].(string)
+	if contextID == "" {
+		return nil, errors.New("registerbot: no isolated context id")
+	}
+	cleanup := func() {
+		_, _ = b.control.Call(ctx, "Target.disposeBrowserContext", map[string]any{"browserContextId": contextID})
+	}
+	result, errCall := b.control.Call(ctx, "Target.createTarget", map[string]any{"url": "about:blank", "browserContextId": contextID})
+	if errCall != nil {
+		cleanup()
+		return nil, fmt.Errorf("registerbot: create target: %w", errCall)
+	}
+	targetID, _ := result["targetId"].(string)
+	if strings.TrimSpace(targetID) == "" {
+		cleanup()
+		return nil, errors.New("registerbot: create target returned no target id")
+	}
+	attached, errAttach := b.control.Call(ctx, "Target.attachToTarget", map[string]any{"targetId": targetID, "flatten": true})
+	if errAttach != nil {
+		cleanup()
+		return nil, fmt.Errorf("registerbot: attach target: %w", errAttach)
+	}
+	sessionID, _ := attached["sessionId"].(string)
+	session := &Session{client: b.control, sessionID: sessionID, targetID: targetID, contextID: contextID, instance: b}
+	b.mu.Lock()
+	b.contexts++
+	b.mu.Unlock()
+	for _, method := range []string{"Page.enable", "Runtime.enable", "Log.enable"} {
+		if _, errEnable := session.call(ctx, method, nil); errEnable != nil {
+			// A missing domain only narrows observation, never the run itself.
+			_ = errEnable
+		}
+	}
+	if _, errScript := session.call(ctx, "Page.addScriptToEvaluateOnNewDocument", map[string]any{"source": helperScript}); errScript != nil {
+		_ = session.CloseTarget(ctx)
+		return nil, errScript
+	}
+	if errInstall := session.InstallHelpers(ctx); errInstall != nil {
+		_ = session.CloseTarget(ctx)
+		return nil, errInstall
+	}
+	if errNavigate := session.Navigate(ctx, initialURL); errNavigate != nil {
+		_ = session.CloseTarget(ctx)
+		return nil, errNavigate
+	}
+	return session, nil
+}
+
+// CloseTarget drops the tab and its session.
+func (s *Session) CloseTarget(ctx context.Context) error {
+	if s == nil || s.client == nil || strings.TrimSpace(s.targetID) == "" {
+		return nil
+	}
+	var errClose error
+	s.closeOnce.Do(func() {
+		if s.contextID != "" {
+			_, errClose = s.client.Call(ctx, "Target.disposeBrowserContext", map[string]any{"browserContextId": s.contextID})
+		} else {
+			_, errClose = s.client.Call(ctx, "Target.closeTarget", map[string]any{"targetId": s.targetID})
+		}
+		if s.instance != nil {
+			s.instance.mu.Lock()
+			s.instance.contexts--
+			s.instance.mu.Unlock()
+		}
+	})
+	return errClose
+}
+
+// FollowAuthorizationPopup follows only a provider/Google popup opened by the
+// current page inside this account's own browser context.
+func (s *Session) FollowAuthorizationPopup(ctx context.Context) error {
+	result, errTargets := s.client.Call(ctx, "Target.getTargets", nil)
+	if errTargets != nil {
+		return errTargets
+	}
+	infos, _ := result["targetInfos"].([]any)
+	currentExists := false
+	for _, raw := range infos {
+		if info, ok := raw.(map[string]any); ok && info["targetId"] == s.targetID {
+			currentExists = true
+		}
+	}
+	for _, raw := range infos {
+		info, ok := raw.(map[string]any)
+		if !ok || info["type"] != "page" || info["browserContextId"] != s.contextID {
+			continue
+		}
+		isChild := info["openerId"] == s.targetID
+		isReturning := !currentExists && s.openerID != "" && info["targetId"] == s.openerID
+		if !isChild && !isReturning {
+			continue
+		}
+		address, _ := info["url"].(string)
+		if !googleIdentityHost(address) && !freeAIHost(address) {
+			continue
+		}
+		targetID, _ := info["targetId"].(string)
+		attached, errAttach := s.client.Call(ctx, "Target.attachToTarget", map[string]any{"targetId": targetID, "flatten": true})
+		if errAttach != nil {
+			return errAttach
+		}
+		s.sessionID, _ = attached["sessionId"].(string)
+		if isChild {
+			s.openerID = s.targetID
+		} else {
+			s.openerID = ""
+		}
+		s.targetID = targetID
+		_, _ = s.call(ctx, "Page.enable", nil)
+		_, _ = s.call(ctx, "Runtime.enable", nil)
+		_, _ = s.call(ctx, "Page.addScriptToEvaluateOnNewDocument", map[string]any{"source": helperScript})
+		return s.InstallHelpers(ctx)
+	}
+	return nil
+}
+
+// Navigate loads a URL and waits for the load event.
+func (s *Session) Navigate(ctx context.Context, targetURL string) error {
+	result, errCall := s.call(ctx, "Page.navigate", map[string]any{"url": normalizeURL(targetURL)})
+	if errCall != nil {
+		return fmt.Errorf("registerbot: navigate: %w", errCall)
+	}
+	if failure, _ := result["errorText"].(string); failure != "" {
+		return navigationFailure(failure)
+	}
+	return s.WaitForLoad(ctx)
+}
+
+// NavigationError contains only a stable browser error code, never a URL or page
+// content. The queue retries it rather than misclassifying a network failure as
+// an identity challenge requiring human intervention.
+type NavigationError struct{ Code string }
+
+func (e *NavigationError) Error() string { return "registerbot: navigation failed (" + e.Code + ")" }
+
+func navigationFailure(raw string) *NavigationError {
+	code := strings.TrimPrefix(strings.TrimSpace(raw), "net::")
+	switch code {
+	case "ERR_CONNECTION_RESET", "ERR_CONNECTION_CLOSED", "ERR_CONNECTION_TIMED_OUT", "ERR_NAME_NOT_RESOLVED", "ERR_PROXY_CONNECTION_FAILED", "ERR_TUNNEL_CONNECTION_FAILED", "ERR_SSL_PROTOCOL_ERROR", "ERR_INTERNET_DISCONNECTED", "ERR_CONNECTION_REFUSED", "ERR_ABORTED", "ERR_NETWORK_CHANGED", "ERR_EMPTY_RESPONSE", "ERR_TIMED_OUT", "ERR_ADDRESS_UNREACHABLE", "ERR_CERT_AUTHORITY_INVALID", "ERR_CERT_DATE_INVALID":
+		return &NavigationError{Code: code}
+	default:
+		return &NavigationError{Code: "ERR_FAILED"}
+	}
+}
+
+// WaitForLoad waits for Page.loadEventFired, or for readyState when it already passed.
+func (s *Session) WaitForLoad(ctx context.Context) error {
+	if ready, errReady := s.readyState(ctx); errReady == nil && ready == "complete" {
+		return nil
+	}
+	done := make(chan struct{}, 1)
+	stop := s.client.subscribe("Page.loadEventFired", s.sessionID, func(cdpMessage) {
+		select {
+		case done <- struct{}{}:
+		default:
+		}
+	})
+	defer stop()
+	for {
+		if ready, errReady := s.readyState(ctx); errReady == nil && ready == "complete" {
+			return nil
+		}
+		select {
+		case <-done:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(300 * time.Millisecond):
+		}
+	}
+}
+
+func (s *Session) readyState(ctx context.Context) (string, error) {
+	value, errEval := s.Evaluate(ctx, "document.readyState", false)
+	if errEval != nil {
+		return "", errEval
+	}
+	if text, ok := value.(string); ok {
+		return text, nil
+	}
+	return "", nil
+}
+
+// CurrentURL reads location.href.
+func (s *Session) CurrentURL(ctx context.Context) string {
+	value, errEval := s.Evaluate(ctx, "location.href", false)
+	if errEval != nil {
+		return ""
+	}
+	if text, ok := value.(string); ok {
+		return text
+	}
+	return ""
+}
+
+// PageTitle reads document.title.
+func (s *Session) PageTitle(ctx context.Context) string {
+	value, errEval := s.Evaluate(ctx, "document.title", false)
+	if errEval != nil {
+		return ""
+	}
+	if text, ok := value.(string); ok {
+		return text
+	}
+	return ""
+}
+
+// Evaluate runs an expression and decodes a primitive result.
+func (s *Session) Evaluate(ctx context.Context, expression string, awaitPromise bool) (any, error) {
+	result, errCall := s.call(ctx, "Runtime.evaluate", map[string]any{
+		"expression":    expression,
+		"returnByValue": true,
+		"awaitPromise":  awaitPromise,
+		"userGesture":   true,
+	})
+	if errCall != nil {
+		return nil, errCall
+	}
+	if exception, ok := result["exceptionDetails"].(map[string]any); ok && exception != nil {
+		text, _ := exception["text"].(string)
+		if text == "" {
+			if desc, okDesc := exception["description"].(string); okDesc {
+				text = desc
+			}
+		}
+		return nil, errors.New("registerbot: page script evaluation failed")
+	}
+	inner, _ := result["result"].(map[string]any)
+	if inner == nil {
+		return nil, nil
+	}
+	if value, ok := inner["value"]; ok {
+		return value, nil
+	}
+	return nil, nil
+}
+
+// EvaluateString runs an expression and requires a string result.
+func (s *Session) EvaluateString(ctx context.Context, expression string, awaitPromise bool) (string, error) {
+	value, errEval := s.Evaluate(ctx, expression, awaitPromise)
+	if errEval != nil {
+		return "", errEval
+	}
+	if text, ok := value.(string); ok {
+		return text, nil
+	}
+	return "", nil
+}
+
+// waitFor polls an expression until it is truthy or the context expires.
+func (s *Session) waitFor(ctx context.Context, expression string, interval time.Duration) error {
+	if interval <= 0 {
+		interval = 250 * time.Millisecond
+	}
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		if value, errEval := s.Evaluate(ctx, expression, false); errEval == nil && truthy(value) {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("registerbot: page condition timed out: %w", ctx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+func truthy(value any) bool {
+	switch typed := value.(type) {
+	case bool:
+		return typed
+	case string:
+		return typed != "" && typed != "false" && typed != "null"
+	case float64:
+		return typed != 0
+	case nil:
+		return false
+	default:
+		return true
+	}
+}
+
+// WaitForSelector polls until a CSS selector resolves to a visible element.
+func (s *Session) WaitForSelector(ctx context.Context, selector string) error {
+	return s.waitFor(ctx, fmt.Sprintf("cpaVisible(%s)", jsString(selector)), 200*time.Millisecond)
+}
+
+// WaitForText polls until a visible control carries the given label.
+func (s *Session) WaitForText(ctx context.Context, text string) error {
+	return s.waitFor(ctx, fmt.Sprintf("cpaTextVisible(%s)", jsString(text)), 250*time.Millisecond)
+}
+
+// InstallHelpers defines the DOM helpers used by every interaction step.
+func (s *Session) InstallHelpers(ctx context.Context) error {
+	if _, errEval := s.Evaluate(ctx, helperScript, false); errEval != nil {
+		return fmt.Errorf("registerbot: install page helpers: %w", errEval)
+	}
+	return nil
+}
+
+// helperScript is injected once per target. It locates visible controls, reports
+// page state for stall diagnostics, and never redefines itself after navigation
+// because the execution context is recreated with the document.
+const helperScript = `(function () {
+  if (window.__cpaHelpers) { return true; }
+  window.__cpaHelpers = true;
+  var norm = function (v) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().toLowerCase(); };
+  var visible = function (el) {
+    if (!el) { return false; }
+    var r = el.getBoundingClientRect();
+    if (r.width < 2 || r.height < 2) { return false; }
+    var st = window.getComputedStyle(el);
+    if (st.visibility === 'hidden' || st.display === 'none' || parseFloat(st.opacity) < 0.05) { return false; }
+    return true;
+  };
+  var shadowSearch = function (sel) {
+    var matches = document.querySelectorAll(sel);
+    for (var k = 0; k < matches.length; k++) { if (visible(matches[k])) { return matches[k]; } }
+    var hosts = document.querySelectorAll('*');
+    for (var i = 0; i < hosts.length; i++) {
+      if (!hosts[i].shadowRoot) { continue; }
+      var inner = hosts[i].shadowRoot.querySelectorAll(sel);
+      for (var j = 0; j < inner.length; j++) { if (visible(inner[j])) { return inner[j]; } }
+    }
+    return null;
+  };
+  window.cpaVisible = function (sel) {
+    var el = shadowSearch(sel);
+    if (!el) { return false; }
+    if (visible(el)) { return true; }
+    var pool = el.querySelectorAll ? el.querySelectorAll('*') : [];
+    for (var i = 0; i < pool.length; i++) { if (visible(pool[i])) { return true; } }
+    return false;
+  };
+  window.cpaTextVisible = function (text) {
+    var want = norm(text);
+    if (!want) { return false; }
+    var nodes = document.querySelectorAll('button, [role="button"], a, input[type=submit], label, [jsaction]');
+    for (var i = 0; i < nodes.length; i++) {
+      var label = norm(nodes[i].innerText || nodes[i].textContent || nodes[i].value || nodes[i].getAttribute('aria-label') || '');
+      if (label && label.indexOf(want) >= 0 && visible(nodes[i])) { return true; }
+    }
+    return false;
+  };
+  var mark = function (el) {
+    var prev = document.querySelector('[data-cpa-target]');
+    if (prev) { prev.removeAttribute('data-cpa-target'); }
+    el.setAttribute('data-cpa-target', '1');
+    var r = el.getBoundingClientRect();
+    return { x: r.left + r.width / 2, y: r.top + r.height / 2, text: norm(el.innerText || el.getAttribute('aria-label')), id: el.id || '' };
+  };
+  window.cpaFindButton = function (text) {
+    var want = norm(text);
+    if (!want) { return null; }
+    var nodes = document.querySelectorAll('button, [role="button"], a, input[type=submit], [jsaction]');
+    var best = null, bestScore = 0;
+    for (var i = 0; i < nodes.length; i++) {
+      var el = nodes[i];
+      var label = norm(el.innerText || el.textContent || el.value || el.getAttribute('aria-label') || '');
+      if (!label) { continue; }
+      var score = 0;
+      if (label === want) { score = 3; } else if (label.indexOf(want) === 0) { score = 2; } else if (label.indexOf(want) >= 0) { score = 1; }
+      if (score > bestScore && visible(el) && !el.disabled) { bestScore = score; best = el; }
+    }
+    if (!best) { return null; }
+    return mark(best);
+  };
+  window.cpaFindInput = function (selector, label) {
+    var el = selector ? shadowSearch(selector) : null;
+    if (el && !visible(el)) { el = null; }
+    if (!el && label) {
+      var want = norm(label);
+      var inputs = document.querySelectorAll('input, textarea');
+      for (var j = 0; j < inputs.length; j++) {
+        var cand = inputs[j];
+        var hint = norm(cand.getAttribute('aria-label') || cand.getAttribute('placeholder') || cand.name || cand.id || '');
+        if (hint && hint.indexOf(want) >= 0 && visible(cand)) { el = cand; break; }
+      }
+    }
+    if (!el) { return null; }
+    return mark(el);
+  };
+  window.cpaReadAll = function () {
+    var text = document.body ? document.body.innerText : '';
+    return String(text) + '\n' + document.documentElement.outerHTML;
+  };
+  window.cpaState = function () {
+    var alerts = [];
+    document.querySelectorAll('[role="alert"], .ErOBK, .RLvSzb, [jsname="LgwsAd"]').forEach(function (n) {
+      var t = norm(n.innerText || n.textContent);
+      if (t) { alerts.push(t); }
+    });
+    var buttons = [];
+    document.querySelectorAll('button, [role="button"], input[type=submit]').forEach(function (n) {
+      if (!visible(n)) { return; }
+      var t = norm(n.innerText || n.value || n.getAttribute('aria-label'));
+      if (t) { buttons.push((n.disabled ? '~' : '') + t); }
+    });
+    var fields = [];
+    document.querySelectorAll('input, textarea').forEach(function (n) {
+      if (!visible(n)) { return; }
+      fields.push({ id: n.id || '', name: n.name || '', type: n.type || '', label: norm(n.getAttribute('aria-label') || n.getAttribute('placeholder') || '') });
+    });
+    return {
+      url: location.href,
+      title: document.title,
+      ready: document.readyState,
+      busy: !!document.querySelector('[aria-busy="true"]'),
+      errors: alerts.slice(0, 4),
+      buttons: buttons.slice(0, 20),
+      fields: fields.slice(0, 10)
+    };
+  };
+  return true;
+})()`
+
+func normalizeURL(raw string) string {
+	value := strings.TrimSpace(raw)
+	if value == "" {
+		return "about:blank"
+	}
+	if strings.HasPrefix(value, "http://") || strings.HasPrefix(value, "https://") || strings.HasPrefix(value, "about:") || strings.HasPrefix(value, "data:") {
+		return value
+	}
+	return "https://" + value
+}
+
+// jsString renders a Go string as a single quoted JavaScript literal.
+func jsString(value string) string {
+	builder := strings.Builder{}
+	builder.WriteByte('\'')
+	for _, r := range value {
+		switch r {
+		case '\\':
+			builder.WriteString(`\\`)
+		case '\'':
+			builder.WriteString(`\'`)
+		case '\n':
+			builder.WriteString(`\n`)
+		case '\r':
+			builder.WriteString(`\r`)
+		case '\t':
+			builder.WriteString(`\t`)
+		default:
+			builder.WriteRune(r)
+		}
+	}
+	builder.WriteByte('\'')
+	return builder.String()
+}
+
+type clickPoint struct {
+	x float64
+	y float64
+}
+
+func asPoint(value any) (clickPoint, bool) {
+	doc, ok := value.(map[string]any)
+	if !ok || doc == nil {
+		return clickPoint{}, false
+	}
+	x, okX := doc["x"].(float64)
+	y, okY := doc["y"].(float64)
+	if !okX || !okY {
+		return clickPoint{}, false
+	}
+	return clickPoint{x: x, y: y}, true
+}
+
+// locateText resolves the first visible control matching one of the labels.
+func (s *Session) locateText(ctx context.Context, texts []string) (clickPoint, string, error) {
+	for _, text := range texts {
+		if strings.TrimSpace(text) == "" {
+			continue
+		}
+		value, errEval := s.Evaluate(ctx, fmt.Sprintf("cpaFindButton(%s)", jsString(text)), false)
+		if errEval != nil {
+			return clickPoint{}, "", errEval
+		}
+		if point, ok := asPoint(value); ok {
+			return point, text, nil
+		}
+	}
+	return clickPoint{}, "", fmt.Errorf("registerbot: no enabled control labelled %q", strings.Join(texts, " / "))
+}
+
+// ClickText performs a real mouse click on the first visible enabled control
+// whose label matches one of the given texts, in order.
+func (s *Session) ClickText(ctx context.Context, texts ...string) error {
+	point, _, errLocate := s.locateText(ctx, texts)
+	if errLocate != nil {
+		return errLocate
+	}
+	return s.clickAt(ctx, point.x, point.y)
+}
+
+// ClickSelector performs a real mouse click on the element matching a selector.
+func (s *Session) ClickSelector(ctx context.Context, selector string) error {
+	value, errEval := s.Evaluate(ctx, fmt.Sprintf("cpaFindInput(%s, '')", jsString(selector)), false)
+	if errEval != nil {
+		return errEval
+	}
+	point, ok := asPoint(value)
+	if !ok {
+		return fmt.Errorf("registerbot: selector %q matched nothing visible", selector)
+	}
+	return s.clickAt(ctx, point.x, point.y)
+}
+
+// clickAt dispatches a real press and release through the Input domain.
+func (s *Session) clickAt(ctx context.Context, x, y float64) error {
+	if _, errMove := s.call(ctx, "Input.dispatchMouseEvent", map[string]any{"type": "mouseMoved", "x": x, "y": y}); errMove != nil {
+		return fmt.Errorf("registerbot: mouse move: %w", errMove)
+	}
+	base := map[string]any{"x": x, "y": y, "button": "left", "clickCount": 1, "buttons": 1, "pointerType": "mouse"}
+	pressed := map[string]any{"type": "mousePressed"}
+	for key, value := range base {
+		pressed[key] = value
+	}
+	if _, errPress := s.call(ctx, "Input.dispatchMouseEvent", pressed); errPress != nil {
+		return fmt.Errorf("registerbot: mouse press: %w", errPress)
+	}
+	released := map[string]any{"type": "mouseReleased", "buttons": 0}
+	for key, value := range base {
+		released[key] = value
+	}
+	if _, errRelease := s.call(ctx, "Input.dispatchMouseEvent", released); errRelease != nil {
+		return fmt.Errorf("registerbot: mouse release: %w", errRelease)
+	}
+	return nil
+}
+
+// TypeInto focuses a field, clears it, then sends real keystrokes in chunks.
+// Google's client side validation only accepts input events, so the engine never
+// assigns value directly.
+func (s *Session) TypeInto(ctx context.Context, selector, label, value string) error {
+	result, errEval := s.Evaluate(ctx, fmt.Sprintf("cpaFindInput(%s, %s)", jsString(selector), jsString(label)), false)
+	if errEval != nil {
+		return errEval
+	}
+	point, ok := asPoint(result)
+	if !ok {
+		return fmt.Errorf("registerbot: field %q (%s) not found", selector, label)
+	}
+	if errClick := s.clickAt(ctx, point.x, point.y); errClick != nil {
+		return errClick
+	}
+	if _, errSelect := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+		"type": "rawKeyDown", "key": "a", "code": "KeyA", "modifiers": 2,
+		"windowsVirtualKeyCode": 65, "nativeVirtualKeyCode": 65,
+	}); errSelect != nil {
+		return fmt.Errorf("registerbot: select all: %w", errSelect)
+	}
+	if _, errUp := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+		"type": "keyUp", "key": "a", "code": "KeyA", "modifiers": 2,
+		"windowsVirtualKeyCode": 65, "nativeVirtualKeyCode": 65,
+	}); errUp != nil {
+		return fmt.Errorf("registerbot: select all release: %w", errUp)
+	}
+	if _, errClear := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+		"type": "rawKeyDown", "key": "Backspace", "code": "Backspace",
+		"windowsVirtualKeyCode": 8, "nativeVirtualKeyCode": 8,
+	}); errClear != nil {
+		return fmt.Errorf("registerbot: clear field: %w", errClear)
+	}
+	for _, chunk := range splitChunks(value, 8) {
+		if _, errInsert := s.call(ctx, "Input.insertText", map[string]any{"text": chunk}); errInsert != nil {
+			return fmt.Errorf("registerbot: insert text: %w", errInsert)
+		}
+	}
+	return nil
+}
+
+func splitChunks(value string, size int) []string {
+	runes := []rune(value)
+	var out []string
+	for i := 0; i < len(runes); i += size {
+		end := i + size
+		if end > len(runes) {
+			end = len(runes)
+		}
+		out = append(out, string(runes[i:end]))
+	}
+	return out
+}
+
+// PressKey sends one named key chord such as Enter.
+func (s *Session) PressKey(ctx context.Context, key string) error {
+	defined, ok := keyDefinitions[key]
+	if !ok {
+		return fmt.Errorf("registerbot: unsupported key %q", key)
+	}
+	if _, errDown := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+		"type": "rawKeyDown", "key": defined.key, "code": defined.code,
+		"windowsVirtualKeyCode": defined.virtual, "nativeVirtualKeyCode": defined.virtual,
+	}); errDown != nil {
+		return fmt.Errorf("registerbot: key down %s: %w", key, errDown)
+	}
+	if defined.text != "" {
+		if _, errChar := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+			"type": "char", "key": defined.key, "code": defined.code, "text": defined.text,
+			"unmodifiedText":        defined.text,
+			"windowsVirtualKeyCode": defined.virtual, "nativeVirtualKeyCode": defined.virtual,
+		}); errChar != nil {
+			return fmt.Errorf("registerbot: key char %s: %w", key, errChar)
+		}
+	}
+	if _, errUp := s.call(ctx, "Input.dispatchKeyEvent", map[string]any{
+		"type": "keyUp", "key": defined.key, "code": defined.code,
+		"windowsVirtualKeyCode": defined.virtual, "nativeVirtualKeyCode": defined.virtual,
+	}); errUp != nil {
+		return fmt.Errorf("registerbot: key up %s: %w", key, errUp)
+	}
+	return nil
+}
+
+type keyDefinition struct {
+	key     string
+	code    string
+	text    string
+	virtual int
+}
+
+var keyDefinitions = map[string]keyDefinition{
+	"Enter":     {key: "Enter", code: "Enter", text: "\r", virtual: 13},
+	"Tab":       {key: "Tab", code: "Tab", text: "\t", virtual: 9},
+	"Escape":    {key: "Escape", code: "Escape", virtual: 27},
+	"Backspace": {key: "Backspace", code: "Backspace", virtual: 8},
+	"PageDown":  {key: "PageDown", code: "PageDown", virtual: 34},
+	"End":       {key: "End", code: "End", virtual: 35},
+}
+
+// ScrollToEnd pages a long consent screen so its accept control becomes usable.
+func (s *Session) ScrollToEnd(ctx context.Context) error {
+	_, errEval := s.Evaluate(ctx, `(function(){
+		window.scrollTo(0, document.body.scrollHeight);
+		var boxes = document.querySelectorAll('[style*="overflow"], [class*="scroll"], [jsname]');
+		for (var i = 0; i < boxes.length; i++) { boxes[i].scrollTop = boxes[i].scrollHeight; }
+		return true;
+	})()`, false)
+	if errEval != nil {
+		return fmt.Errorf("registerbot: scroll page: %w", errEval)
+	}
+	return nil
+}
+
+// Screenshot captures the viewport as PNG bytes for stall evidence.
+func (s *Session) Screenshot(ctx context.Context) ([]byte, error) {
+	result, errCall := s.call(ctx, "Page.captureScreenshot", map[string]any{"format": "png"})
+	if errCall != nil {
+		return nil, errCall
+	}
+	data, _ := result["data"].(string)
+	if strings.TrimSpace(data) == "" {
+		return nil, errors.New("registerbot: screenshot returned no data")
+	}
+	decoded, errDecode := base64.StdEncoding.DecodeString(data)
+	if errDecode != nil {
+		return nil, fmt.Errorf("registerbot: decode screenshot: %w", errDecode)
+	}
+	return decoded, nil
+}
+
+// PageText returns the visible text plus markup, used for key harvesting.
+func (s *Session) PageText(ctx context.Context) (string, error) {
+	return s.EvaluateString(ctx, "cpaReadAll()", false)
+}
+
+// State returns a compact page snapshot used for stall diagnostics.
+func (s *Session) State(ctx context.Context) (map[string]any, error) {
+	value, errEval := s.Evaluate(ctx, "cpaState()", false)
+	if errEval != nil {
+		return nil, errEval
+	}
+	if doc, ok := value.(map[string]any); ok && doc != nil {
+		return doc, nil
+	}
+	return nil, errors.New("registerbot: page state was not an object")
+}
+
+// SetDownloadBehavior lets a pooled instance save files into its own directory.
+func (b *browserInstance) SetDownloadBehavior(ctx context.Context, dir string) error {
+	if b == nil || b.control == nil {
+		return errors.New("registerbot: browser instance unavailable")
+	}
+	_, errCall := b.control.Call(ctx, "Browser.setDownloadBehavior", map[string]any{"behavior": "allow", "downloadPath": dir})
+	if errCall != nil {
+		return fmt.Errorf("registerbot: set download behaviour: %w", errCall)
+	}
+	return nil
+}
diff --git a/internal/registerbot/channel.go b/internal/registerbot/channel.go
new file mode 100644
index 0000000..3376e72
--- /dev/null
+++ b/internal/registerbot/channel.go
@@ -0,0 +1,369 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/MoeForge/moego/regexp"
+)
+
+// Channel kinds shipped with the registerbot.
+const (
+	ChannelKindFreeAIApiKey = "freeaiapikey"
+)
+
+// KnownChannelKinds lists the kinds the settings validator accepts.
+var KnownChannelKinds = []string{ChannelKindFreeAIApiKey}
+
+// ErrManualHandoff preserves a checkpoint while the operator finishes verification.
+var ErrManualHandoff = errors.New("registerbot: operator action required")
+
+func errString(err error) string {
+	if err == nil {
+		return ""
+	}
+	return "operation unavailable"
+}
+
+// KnownChannelKind reports whether a kind has a driver.
+func KnownChannelKind(kind string) bool {
+	for _, known := range KnownChannelKinds {
+		if known == strings.TrimSpace(kind) {
+			return true
+		}
+	}
+	return false
+}
+
+// Account is one credential pair in the batch queue.
+type Account struct {
+	Email    string
+	Password string
+}
+
+// Masked renders the identity without ever exposing the secret.
+func (a Account) Masked() string {
+	name, domain := splitEmail(a.Email)
+	if domain == "" {
+		return "[redacted]"
+	}
+	return name[:minInt(len(name), 2)] + "***@" + domain
+}
+
+func splitEmail(email string) (local, domain string) {
+	if at := strings.Index(email, "@"); at >= 0 {
+		return email[:at], email[at+1:]
+	}
+	return email, ""
+}
+
+func minInt(left, right int) int {
+	if left < right {
+		return left
+	}
+	return right
+}
+
+// accountRow is one parsed input line.
+type accountRow struct {
+	line     int
+	email    string
+	password string
+	status   string // valid | duplicate | invalid
+}
+
+var (
+	emailPattern   = regexp.MustCompile(`^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$`)
+	keyPattern     = regexp.MustCompile(`sk-[A-Za-z0-9_\-]{16,}`)
+	keyValueInline = regexp.MustCompile(`keyValue\s*=\s*["']([^"']+)["']`)
+)
+
+// MaxAccountRows bounds one submitted batch, keeping the work queue predictable.
+const MaxAccountRows = 500
+
+// parseAccounts turns the panel textarea into validated rows.
+//
+// Accepted format is `account|password`, one per line. Blank lines and lines
+// starting with # are ignored, so a paste can carry comments. Later duplicates of
+// the same address are marked instead of silently dropped, because the operator
+// needs to see that the queue held a repeat.
+func parseAccounts(text string) ([]accountRow, error) {
+	if len(text) > MaxAccountRows*514 {
+		return nil, fmt.Errorf("registerbot: batch too large (max %d rows)", MaxAccountRows)
+	}
+	lines := strings.Split(strings.ReplaceAll(text, "\r\n", "\n"), "\n")
+	seen := make(map[string]int, len(lines))
+	var out []accountRow
+	for index, raw := range lines {
+		line := strings.TrimSpace(raw)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		if len(out) >= MaxAccountRows {
+			return out, fmt.Errorf("registerbot: batch limit %d reached", MaxAccountRows)
+		}
+		parts := strings.SplitN(raw, "|", 2)
+		if len(parts) != 2 {
+			out = append(out, accountRow{line: index + 1, status: "invalid"})
+			continue
+		}
+		email := strings.ToLower(strings.TrimSpace(parts[0]))
+		password := parts[1]
+		if !emailPattern.MatchString(email) || password == "" {
+			out = append(out, accountRow{line: index + 1, status: "invalid"})
+			continue
+		}
+		if previous, dup := seen[email]; dup {
+			out = append(out, accountRow{line: index + 1, email: email, status: "duplicate"})
+			_ = previous
+			continue
+		}
+		seen[email] = index + 1
+		out = append(out, accountRow{line: index + 1, email: email, password: password, status: "valid"})
+	}
+	return out, nil
+}
+
+// Driver runs one account through one channel.
+//
+// Implementations report progress through the context, never through return
+// values, so the panel sees each stage the moment it starts. A driver returns
+// ErrManualHandoff when it must wait for the operator.
+type Driver interface {
+	Kind() string
+	Run(ctx context.Context, task *Task) (Harvest, error)
+	// Probe checks reachability of the channel entry point without registering.
+	Probe(ctx context.Context) error
+}
+
+// Harvest is what a successful account run produced.
+type Harvest struct {
+	APIKey               string
+	VerificationProxyURL string
+	Account              string
+	Node                 string
+	ExitIP               string
+	Browser              string
+	StartedAt            time.Time
+	FinishedAt           time.Time
+}
+
+// Task carries everything a driver needs for one account.
+type Task struct {
+	Channel ChannelSettings
+	Run     string
+	RowID   string
+	Account Account
+	Attempt int
+
+	bus      *Bus
+	evidence *Evidence
+	browser  *browserInstance
+	settings func() Settings
+	session  *Session
+	onReport func(stage string)
+	node     string
+	exitIP   string
+
+	mu       sync.Mutex
+	lastURL  string
+	lastNote string
+}
+
+// Report emits a stage event bound to this account.
+func (t *Task) Report(stage, level, message string) {
+	if t.onReport != nil {
+		t.onReport(stage)
+	}
+	message = strings.ReplaceAll(message, t.Account.Email, t.Account.Masked())
+	if t.Account.Password != "" {
+		message = strings.ReplaceAll(message, t.Account.Password, "[redacted]")
+	}
+	t.mu.Lock()
+	node, exitIP := t.node, t.exitIP
+	t.mu.Unlock()
+	t.bus.Emit(Event{
+		Channel: t.Channel.ID, Run: t.Run, Account: t.Account.Masked(),
+		Stage: stage, Level: level, Message: message,
+		Node: node, ExitIP: exitIP, Browser: t.browserLabel(),
+	})
+}
+
+func (t *Task) browserLabel() string {
+	if t.browser == nil {
+		return ""
+	}
+	return fmt.Sprintf("%s#%d", t.browser.Mode(), t.browser.ID())
+}
+
+// SetPinnedNode records the gateway decision for this account's events.
+func (t *Task) SetPinnedNode(node, exitIP string) {
+	t.mu.Lock()
+	t.node, t.exitIP = node, exitIP
+	t.mu.Unlock()
+}
+
+// StepDelay paces two UI actions so the batch looks like a human typing.
+func (t *Task) StepDelay(ctx context.Context) error {
+	delay := t.Channel.StepDelay()
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+// OpenSession starts a pooled browser tab ready for interaction.
+func (t *Task) OpenSession(ctx context.Context, startURL string) (*Session, error) {
+	if t.session != nil {
+		return t.session, nil
+	}
+	if t.browser == nil {
+		return nil, ErrManualHandoff
+	}
+	session, errOpen := t.browser.OpenPage(ctx, startURL)
+	if errOpen != nil {
+		return nil, errOpen
+	}
+	t.lastURL = startURL
+	t.session = session
+	return session, nil
+}
+
+// CaptureEvidence stores a screenshot plus the sanitized page state of a stall.
+func (t *Task) CaptureEvidence(ctx context.Context, session *Session, reason string) string {
+	if t.evidence == nil {
+		return ""
+	}
+	name := fmt.Sprintf("%s-%s-%d-%s.json", sanitizeName(t.Channel.ID), sanitizeName(t.RowID), time.Now().Unix(), sanitizeName(reason))
+	// Never persist raw authentication pages, which can contain passwords or tokens.
+	payload, errMarshal := json.Marshal(map[string]string{"stage": sanitizeName(reason), "browser": t.browserLabel()})
+	if errMarshal != nil {
+		return ""
+	}
+	path, errWrite := t.evidence.Write(name, payload)
+	if errWrite != nil {
+		return ""
+	}
+	return filepath.Base(path)
+}
+
+func sanitizeName(value string) string {
+	var builder strings.Builder
+	for _, r := range value {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
+			builder.WriteRune(r)
+		default:
+			builder.WriteRune('-')
+		}
+	}
+	out := builder.String()
+	if len(out) > 48 {
+		out = out[:48]
+	}
+	return out
+}
+
+// Evidence stores screenshots and page state for stalled accounts.
+type Evidence struct {
+	dir  string
+	max  int
+	mu   sync.Mutex
+	size int
+}
+
+// NewEvidence prepares the evidence directory.
+func NewEvidence(dir string) *Evidence {
+	return &Evidence{dir: dir, max: 60}
+}
+
+// Enabled reports whether evidence capture is on.
+func (e *Evidence) Enabled() bool {
+	return e != nil && strings.TrimSpace(e.dir) != ""
+}
+
+// Write stores one artefact and returns its path. The file name never carries a
+// password, and payloads are limited so a long run cannot fill the disk.
+func (e *Evidence) Write(name string, payload []byte) (string, error) {
+	if e == nil || !e.Enabled() {
+		return "", errors.New("registerbot: evidence capture disabled")
+	}
+	if len(payload) == 0 {
+		return "", nil
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if errMkdir := os.MkdirAll(e.dir, 0o750); errMkdir != nil {
+		return "", fmt.Errorf("registerbot: create evidence dir: %w", errMkdir)
+	}
+	path := filepath.Join(e.dir, name)
+	if errWrite := os.WriteFile(path, payload, 0o600); errWrite != nil {
+		return "", fmt.Errorf("registerbot: write evidence: %w", errWrite)
+	}
+	e.size++
+	e.trimLocked()
+	return path, nil
+}
+
+// trimLocked keeps only the newest entries so evidence never grows without bound.
+func (e *Evidence) trimLocked() {
+	entries, errRead := os.ReadDir(e.dir)
+	if errRead != nil || len(entries) <= e.max {
+		return
+	}
+	// Directory entries come back sorted by name; the timestamp inside each name
+	// keeps ordering meaningful enough for a bounded prune.
+	drop := len(entries) - e.max
+	for i := 0; i < drop; i++ {
+		_ = os.Remove(filepath.Join(e.dir, entries[i].Name()))
+	}
+}
+
+// List returns the newest evidence artefacts.
+func (e *Evidence) List(limit int) []string {
+	if e == nil || !e.Enabled() {
+		return nil
+	}
+	if limit <= 0 {
+		limit = 20
+	}
+	entries, errRead := os.ReadDir(e.dir)
+	if errRead != nil {
+		return nil
+	}
+	var out []string
+	for i := len(entries) - 1; i >= 0 && len(out) < limit; i-- {
+		if entries[i].IsDir() {
+			continue
+		}
+		out = append(out, entries[i].Name())
+	}
+	return out
+}
+
+// Read returns one artefact by name, refusing anything outside the directory.
+func (e *Evidence) Read(name string) ([]byte, error) {
+	if e == nil || !e.Enabled() {
+		return nil, errors.New("registerbot: evidence capture disabled")
+	}
+	clean := filepath.Base(strings.TrimSpace(name))
+	if clean == "." || clean == "" || strings.Contains(clean, "..") {
+		return nil, errors.New("registerbot: invalid evidence name")
+	}
+	data, errRead := os.ReadFile(filepath.Join(e.dir, clean))
+	if errRead != nil {
+		return nil, fmt.Errorf("registerbot: read evidence: %w", errRead)
+	}
+	return data, nil
+}
diff --git a/internal/registerbot/engine.go b/internal/registerbot/engine.go
new file mode 100644
index 0000000..397446a
--- /dev/null
+++ b/internal/registerbot/engine.go
@@ -0,0 +1,844 @@
+package registerbot
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	log "github.com/sirupsen/logrus"
+)
+
+const StagePendingWrite = "pending_write"
+
+// ImportFunc validates the key and commits it through CPA's existing config CAS.
+// A successful return means both verification and the durable provider write passed.
+type ImportFunc func(context.Context, ChannelSettings, Harvest) error
+
+// ImportError exposes only a fixed, non-sensitive category to the panel.
+type ImportError struct{ Reason string }
+
+func (e *ImportError) Error() string { return "registerbot: " + e.Reason }
+func importReason(err error) string {
+	var failure *ImportError
+	if errors.As(err, &failure) {
+		switch failure.Reason {
+		case "verification_failed", "provider_missing", "config_conflict", "write_failed", "import_unavailable":
+			return failure.Reason
+		}
+	}
+	return "verify_or_write_failed"
+}
+
+type StartRequest struct {
+	Channel  string `json:"channel"`
+	Accounts string `json:"accounts"`
+}
+
+type RowView struct {
+	ID        string `json:"id"`
+	Line      int    `json:"line"`
+	Account   string `json:"account"`
+	Stage     string `json:"stage"`
+	Attempt   int    `json:"attempt"`
+	MaskedKey string `json:"masked_key,omitempty"`
+	Reason    string `json:"reason,omitempty"`
+	UpdatedAt int64  `json:"updated_at"`
+}
+
+type RunView struct {
+	ID        string    `json:"id"`
+	Channel   string    `json:"channel"`
+	Status    string    `json:"status"`
+	CreatedAt int64     `json:"created_at"`
+	UpdatedAt int64     `json:"updated_at"`
+	Rows      []RowView `json:"rows"`
+	Counters  Counters  `json:"counters"`
+}
+
+type Snapshot struct {
+	Enabled      bool              `json:"enabled"`
+	Channels     []ChannelSettings `json:"channels"`
+	Runs         []RunView         `json:"runs"`
+	Cursor       int64             `json:"cursor"`
+	StorageError bool              `json:"storage_error,omitempty"`
+}
+
+type queueRow struct {
+	View       RowView `json:"view"`
+	Credential Account `json:"credential"`
+	Result     Harvest `json:"result"`
+	Continue   bool    `json:"continue,omitempty"`
+	busy       bool
+}
+
+type queueRun struct {
+	ID        string      `json:"id"`
+	Channel   string      `json:"channel"`
+	Status    string      `json:"status"`
+	CreatedAt int64       `json:"created_at"`
+	UpdatedAt int64       `json:"updated_at"`
+	Rows      []*queueRow `json:"rows"`
+}
+
+type queueDocument struct {
+	Version int         `json:"version"`
+	Runs    []*queueRun `json:"runs"`
+}
+
+// Engine owns scheduling; all mutable queue state is guarded by mu.
+type Engine struct {
+	mu            sync.Mutex
+	settings      Settings
+	settingsStore *store
+	state         *sealedStore
+	bus           *Bus
+	gateway       *Gateway
+	pool          *Pool
+	evidence      *Evidence
+	importer      ImportFunc
+	runAccount    func(context.Context, *Task, Harvest) (Harvest, error)
+	drivers       map[string]Driver
+	runs          []*queueRun
+	tasks         map[string]*Task
+	cancels       map[string]context.CancelFunc
+	workers       map[string]bool
+	nextStart     map[string]time.Time
+	ctx           context.Context
+	cancel        context.CancelFunc
+	wake          chan struct{}
+	wg            sync.WaitGroup
+	closed        bool
+	storageError  bool
+}
+
+func NewEngine(stateDir string, settings Settings, importer ImportFunc, drivers ...Driver) (*Engine, error) {
+	if strings.TrimSpace(stateDir) == "" {
+		return nil, errors.New("registerbot: state directory is required")
+	}
+	if err := os.MkdirAll(stateDir, 0o700); err != nil {
+		return nil, err
+	}
+	settings.Normalize()
+	st := newStore(filepath.Join(stateDir, "settings.yaml"))
+	if _, errStat := os.Stat(st.path); errors.Is(errStat, os.ErrNotExist) {
+		st.settings = cloneSettings(settings)
+		if err := st.writeLocked(); err != nil {
+			return nil, err
+		}
+	} else {
+		loaded, errLoad := st.Load()
+		if errLoad != nil {
+			return nil, errLoad
+		}
+		settings = loaded
+	}
+	if err := validateSettings(&settings); err != nil {
+		return nil, err
+	}
+	sealed, errState := newSealedStore(stateDir)
+	if errState != nil {
+		return nil, errState
+	}
+	var doc queueDocument
+	if err := sealed.Load(&doc); err != nil {
+		return nil, err
+	}
+	if doc.Version != 0 && doc.Version != 1 {
+		return nil, errors.New("registerbot: unsupported queue version")
+	}
+	bus, errBus := NewBus(stateDir, 2000)
+	if errBus != nil {
+		return nil, errBus
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	e := &Engine{settings: settings, settingsStore: st, state: sealed, bus: bus, importer: importer, drivers: make(map[string]Driver), runs: doc.Runs, tasks: make(map[string]*Task), cancels: make(map[string]context.CancelFunc), workers: make(map[string]bool), nextStart: make(map[string]time.Time), ctx: ctx, cancel: cancel, wake: make(chan struct{})}
+	e.gateway = NewGateway(e.Settings)
+	e.runAccount = e.execute
+	e.pool = NewPool(e.Settings, stateDir)
+	if settings.Evidence {
+		e.evidence = NewEvidence(filepath.Join(stateDir, "evidence"))
+	}
+	if len(drivers) == 0 {
+		drivers = []Driver{NewFreeAIDriver(e.Settings)}
+	}
+	for _, driver := range drivers {
+		if driver != nil {
+			e.drivers[driver.Kind()] = driver
+		}
+	}
+	for _, run := range e.runs {
+		if run.Status == "done" || run.Status == "cancelled" {
+			continue
+		}
+		run.Status = "paused"
+		for _, row := range run.Rows {
+			if !IsTerminal(row.View.Stage) {
+				row.View.Stage = StagePaused
+				row.View.Reason = "restart_resume_required"
+			}
+		}
+	}
+	if err := e.persistLocked(); err != nil {
+		cancel()
+		_ = bus.Close()
+		return nil, err
+	}
+	e.startWorkersLocked()
+	return e, nil
+}
+
+func (e *Engine) Settings() Settings {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return cloneSettings(e.settings)
+}
+func (e *Engine) Events() *Bus      { return e.bus }
+func (e *Engine) Gateway() *Gateway { return e.gateway }
+func (e *Engine) Pool() *Pool       { return e.pool }
+
+func (e *Engine) UpdateSettings(settings Settings) error {
+	settings.Normalize()
+	if err := validateSettings(&settings); err != nil {
+		return err
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed {
+		return errors.New("registerbot: engine closed")
+	}
+	for _, run := range e.runs {
+		for _, row := range run.Rows {
+			if row.busy {
+				return errors.New("registerbot: pause active runs before changing settings")
+			}
+		}
+	}
+	if _, err := e.settingsStore.Update(func(next *Settings) { *next = cloneSettings(settings) }); err != nil {
+		return err
+	}
+	e.settings = cloneSettings(settings)
+	e.startWorkersLocked()
+	e.signalLocked()
+	e.bus.Emit(Event{Stage: "settings_updated", Level: "info", Message: "settings updated"})
+	return nil
+}
+
+func (e *Engine) Snapshot() Snapshot {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	snapshot := Snapshot{Enabled: e.settings.Enabled, Channels: cloneSettings(e.settings).Channels, Runs: make([]RunView, 0, len(e.runs)), StorageError: e.storageError}
+	for _, run := range e.runs {
+		snapshot.Runs = append(snapshot.Runs, e.runViewLocked(run))
+	}
+	snapshot.Cursor = e.bus.LastSeq()
+	return snapshot
+}
+
+func (e *Engine) Start(request StartRequest) (RunView, error) {
+	rows, errParse := parseAccounts(request.Accounts)
+	if errParse != nil {
+		return RunView{}, errParse
+	}
+	if len(rows) == 0 {
+		return RunView{}, errors.New("registerbot: no account rows")
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed || !e.settings.Enabled {
+		return RunView{}, errors.New("registerbot: engine disabled")
+	}
+	channel, ok := e.settings.Channel(request.Channel)
+	if !ok || !channel.Enabled {
+		return RunView{}, errors.New("registerbot: channel unavailable")
+	}
+	if _, ok = e.drivers[channel.Kind]; !ok {
+		return RunView{}, errors.New("registerbot: channel driver unavailable")
+	}
+	if len(e.runs) >= 100 {
+		return RunView{}, errors.New("registerbot: run history limit reached")
+	}
+	now := time.Now().UnixMilli()
+	run := &queueRun{ID: uuid.NewString(), Channel: channel.ID, Status: "queued", CreatedAt: now, UpdatedAt: now, Rows: make([]*queueRow, 0, len(rows))}
+	for _, parsed := range rows {
+		row := &queueRow{Credential: Account{Email: parsed.email, Password: parsed.password}, View: RowView{ID: uuid.NewString(), Line: parsed.line, Stage: StageQueued, UpdatedAt: now}}
+		row.View.Account = row.Credential.Masked()
+		if parsed.status != "valid" {
+			row.View.Stage = StageSkipped
+			row.View.Reason = parsed.status
+			row.Credential.Password = ""
+		}
+		run.Rows = append(run.Rows, row)
+	}
+	e.runs = append(e.runs, run)
+	e.refreshRunLocked(run)
+	if err := e.persistLocked(); err != nil {
+		e.runs = e.runs[:len(e.runs)-1]
+		return RunView{}, err
+	}
+	e.emitProgressLocked(run, StageQueued, "batch accepted")
+	e.signalLocked()
+	return e.runViewLocked(run), nil
+}
+
+func (e *Engine) Action(runID, action string) error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed {
+		return errors.New("registerbot: engine closed")
+	}
+	run := e.findRunLocked(runID)
+	if run == nil {
+		return errors.New("registerbot: run not found")
+	}
+	switch action {
+	case "pause":
+		if run.Status == "done" || run.Status == "cancelled" {
+			return errors.New("registerbot: run already terminal")
+		}
+		run.Status = "paused"
+		for _, row := range run.Rows {
+			if !IsTerminal(row.View.Stage) {
+				row.View.Stage = StagePaused
+				row.View.Reason = "operator_paused"
+				if cancel := e.cancels[row.View.ID]; cancel != nil {
+					cancel()
+				}
+			}
+		}
+	case "resume", "retry":
+		if run.Status == "cancelled" {
+			return errors.New("registerbot: cancelled run cannot resume")
+		}
+		run.Status = "queued"
+		for _, row := range run.Rows {
+			if row.View.Stage == StageDone || row.View.Stage == StageSkipped {
+				continue
+			}
+			if row.View.Stage == StageFailed && action != "retry" {
+				continue
+			}
+			if row.View.Stage == StageFailed {
+				row.View.Attempt = 0
+			}
+			row.View.Stage = StageQueued
+			row.View.Reason = ""
+		}
+	case "cancel":
+		run.Status = "cancelled"
+		for _, row := range run.Rows {
+			if !IsTerminal(row.View.Stage) {
+				row.View.Stage = StageSkipped
+				row.View.Reason = "operator_cancelled"
+			}
+			row.Credential.Password = ""
+			row.Result.APIKey = ""
+			if cancel := e.cancels[row.View.ID]; cancel != nil {
+				cancel()
+			}
+			if !row.busy {
+				e.discardTaskLocked(row.View.ID)
+			}
+		}
+	default:
+		return errors.New("registerbot: unsupported action")
+	}
+	e.refreshRunLocked(run)
+	run.UpdatedAt = time.Now().UnixMilli()
+	if err := e.persistLocked(); err != nil {
+		return err
+	}
+	e.emitProgressLocked(run, run.Status, "batch "+action)
+	e.signalLocked()
+	return nil
+}
+
+func (e *Engine) SubmitKey(runID, rowID, key string) error {
+	key = strings.TrimSpace(key)
+	if !keyPattern.MatchString(key) || keyPattern.FindString(key) != key || len(key) > 4096 {
+		return errors.New("registerbot: invalid key format")
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed {
+		return errors.New("registerbot: engine closed")
+	}
+	run := e.findRunLocked(runID)
+	if run == nil {
+		return errors.New("registerbot: run not found")
+	}
+	for _, row := range run.Rows {
+		if row.View.ID == rowID {
+			if row.busy || IsTerminal(row.View.Stage) || run.Status == "cancelled" {
+				return errors.New("registerbot: row does not accept a key")
+			}
+			proxyURL := e.settings.Gateway.ProxyURL
+			if channel, exists := e.settings.Channel(run.Channel); exists && channel.ProxyURL != "" {
+				proxyURL = channel.ProxyURL
+			}
+			row.Result = Harvest{APIKey: key, Account: row.Credential.Email, VerificationProxyURL: proxyURL}
+			row.View.MaskedKey = maskAPIKey(key)
+			row.View.Stage = StageQueued
+			row.View.Reason = ""
+			row.Continue = true
+			run.Status = "queued"
+			if err := e.persistLocked(); err != nil {
+				return err
+			}
+			e.emitProgressLocked(run, StageQueued, "manual key queued for verification")
+			e.signalLocked()
+			return nil
+		}
+	}
+	return errors.New("registerbot: row not found")
+}
+
+func (e *Engine) startWorkersLocked() {
+	for _, channel := range e.settings.Channels {
+		if e.workers[channel.ID] {
+			continue
+		}
+		e.workers[channel.ID] = true
+		for i := 0; i < 8; i++ {
+			e.wg.Add(1)
+			go e.worker(channel.ID)
+		}
+	}
+}
+
+func (e *Engine) signalLocked() { close(e.wake); e.wake = make(chan struct{}) }
+
+func (e *Engine) worker(channelID string) {
+	defer e.wg.Done()
+	for {
+		e.mu.Lock()
+		if e.closed {
+			e.mu.Unlock()
+			return
+		}
+		channel, exists := e.settings.Channel(channelID)
+		var run *queueRun
+		var row *queueRow
+		var delay time.Duration
+		if exists && channel.Enabled && e.settings.Enabled && !e.storageError {
+			running := 0
+			for _, candidate := range e.runs {
+				if candidate.Channel == channelID {
+					for _, entry := range candidate.Rows {
+						if entry.busy {
+							running++
+						}
+					}
+				}
+			}
+			if running < channel.Concurrency {
+				delay = time.Until(e.nextStart[channelID])
+				if delay <= 0 {
+					for _, candidate := range e.runs {
+						if candidate.Channel != channelID || candidate.Status == "paused" || candidate.Status == "cancelled" {
+							continue
+						}
+						if channel.TargetKeys > 0 {
+							reserved := 0
+							for _, entry := range candidate.Rows {
+								if entry.busy || entry.Result.APIKey != "" || entry.View.Stage == StageDone {
+									reserved++
+								}
+							}
+							if reserved >= channel.TargetKeys {
+								// Captured keys may still need their idempotent write retry.
+								for _, entry := range candidate.Rows {
+									if entry.View.Stage == StageQueued && !entry.busy && entry.Result.APIKey != "" {
+										run, row = candidate, entry
+										break
+									}
+								}
+								if row != nil {
+									break
+								}
+								continue
+							}
+						}
+						for _, entry := range candidate.Rows {
+							if entry.View.Stage == StageQueued && !entry.busy {
+								run, row = candidate, entry
+								break
+							}
+						}
+						if row != nil {
+							break
+						}
+					}
+				}
+			}
+		}
+		if row == nil {
+			wake := e.wake
+			e.mu.Unlock()
+			if delay > 0 {
+				timer := time.NewTimer(delay)
+				select {
+				case <-e.ctx.Done():
+					timer.Stop()
+					return
+				case <-wake:
+					timer.Stop()
+				case <-timer.C:
+				}
+			} else {
+				select {
+				case <-e.ctx.Done():
+					return
+				case <-wake:
+				}
+			}
+			continue
+		}
+		channelCopy := *channel
+		channelCopy.Nodes = append([]string(nil), channel.Nodes...)
+		row.busy = true
+		row.View.Stage = StageValidating
+		row.View.UpdatedAt = time.Now().UnixMilli()
+		if !row.Continue {
+			row.View.Attempt++
+		}
+		row.Continue = false
+		run.Status = "running"
+		e.nextStart[channelID] = time.Now().Add(channel.Interval())
+		ctx, cancel := context.WithCancel(e.ctx)
+		e.cancels[row.View.ID] = cancel
+		if err := e.persistLocked(); err != nil {
+			row.busy = false
+			row.View.Stage = StagePaused
+			run.Status = "paused"
+			delete(e.cancels, row.View.ID)
+			cancel()
+			e.mu.Unlock()
+			continue
+		}
+		e.emitProgressLocked(run, StageValidating, "account started")
+		task := e.tasks[row.View.ID]
+		if task == nil {
+			task = &Task{Channel: channelCopy, Run: run.ID, RowID: row.View.ID, Account: row.Credential, bus: e.bus, evidence: e.evidence, settings: e.Settings}
+			e.tasks[row.View.ID] = task
+		}
+		task.Attempt = row.View.Attempt
+		task.onReport = func(stage string) { e.report(run, row, stage) }
+		harvest := row.Result
+		e.mu.Unlock()
+		result, errRun := e.runAccount(ctx, task, harvest)
+		cancel()
+		e.mu.Lock()
+		row.busy = false
+		delete(e.cancels, row.View.ID)
+		switch {
+		case errRun == nil:
+			row.View.Stage = StageDone
+			row.View.Reason = ""
+			row.View.MaskedKey = maskAPIKey(result.APIKey)
+			row.Result = Harvest{}
+			row.Credential.Password = ""
+			e.discardTaskLocked(row.View.ID)
+		case run.Status == "cancelled":
+			row.View.Stage = StageSkipped
+			row.View.Reason = "operator_cancelled"
+			row.Result = Harvest{}
+			row.Credential.Password = ""
+			e.discardTaskLocked(row.View.ID)
+		case errors.Is(errRun, context.Canceled):
+			if run.Status == "paused" || e.closed {
+				row.View.Stage = StagePaused
+			} else {
+				row.View.Stage = StageQueued
+			}
+			row.Continue = true
+		case result.APIKey != "":
+			row.Result = result
+			row.View.MaskedKey = maskAPIKey(result.APIKey)
+			row.View.Stage = StagePendingWrite
+			row.View.Reason = importReason(errRun)
+			row.Continue = true
+		case errors.Is(errRun, ErrManualHandoff):
+			row.View.Stage = StageWaitingHuman
+			row.View.Reason = "manual_action_required"
+			row.Continue = true
+		default:
+			row.View.Reason = "attempt_failed"
+			if row.View.Attempt < channelCopy.MaxAttempts {
+				row.View.Stage = StageQueued
+			} else {
+				row.View.Stage = StageFailed
+				e.discardTaskLocked(row.View.ID)
+			}
+		}
+		row.View.UpdatedAt = time.Now().UnixMilli()
+		e.refreshRunLocked(run)
+		if channelCopy.TargetKeys > 0 && e.countersLocked(run).Done >= channelCopy.TargetKeys {
+			for _, pending := range run.Rows {
+				if !IsTerminal(pending.View.Stage) && !pending.busy && pending.Result.APIKey == "" {
+					pending.View.Stage = StageSkipped
+					pending.View.Reason = "target_reached"
+					pending.Credential.Password = ""
+					e.discardTaskLocked(pending.View.ID)
+				}
+			}
+			e.refreshRunLocked(run)
+		}
+		_ = e.persistLocked()
+		e.emitProgressLocked(run, row.View.Stage, row.View.Reason)
+		e.signalLocked()
+		e.mu.Unlock()
+	}
+}
+
+func (e *Engine) execute(ctx context.Context, task *Task, harvest Harvest) (Harvest, error) {
+	if harvest.APIKey == "" {
+		if task.Channel.ManualMode {
+			return Harvest{}, ErrManualHandoff
+		}
+		task.Report(StagePinning, "info", "acquiring channel gateway")
+		status := e.gateway.Probe(ctx, false)
+		if status.Mode != GatewayModeController {
+			task.Report("gateway_degraded", "warning", status.Mode)
+		}
+		pinChannel := task.Channel
+		if task.session != nil && task.node != "" {
+			pinChannel.Nodes = []string{task.node}
+			pinChannel.RotateNode = false
+		}
+		pin, errPin := e.gateway.Acquire(ctx, pinChannel, task.RowID)
+		if errPin == nil {
+			defer e.gateway.Release(task.Channel.Group, task.RowID)
+		}
+		if ctx.Err() != nil {
+			return Harvest{}, ctx.Err()
+		}
+		if errPin != nil {
+			task.Report("gateway_degraded", "warning", "gateway unavailable; continuing with fallback")
+		} else {
+			task.SetPinnedNode(pin.Node, pin.ExitIP)
+			if pin.Degraded != "" {
+				task.Report("gateway_degraded", "warning", pin.Degraded)
+			}
+		}
+		e.pool.SetProxyURL(e.gateway.EffectiveProxyURL())
+		if task.session == nil {
+			task.Report(StageBrowserStart, "info", "acquiring pooled browser")
+			instance, errAcquire := e.pool.Acquire(ctx)
+			mode, reason := e.pool.Mode()
+			if mode != BrowserModeEmbedded {
+				task.Report("browser_degraded", "warning", mode+": "+reason)
+			}
+			if errAcquire != nil {
+				if ctx.Err() != nil {
+					return Harvest{}, ctx.Err()
+				}
+				return Harvest{}, ErrManualHandoff
+			}
+			task.browser = instance
+			defer e.pool.Release(instance)
+		}
+		driver := e.drivers[task.Channel.Kind]
+		var errDriver error
+		harvest, errDriver = driver.Run(ctx, task)
+		if errDriver != nil {
+			return harvest, errDriver
+		}
+		if harvest.APIKey == "" {
+			return Harvest{}, errors.New("registerbot: driver returned no key")
+		}
+		harvest.VerificationProxyURL = e.gateway.EffectiveProxyURL()
+		// Persist the key before the external commit. A restart retries only the
+		// idempotent import, never repeats registration for an already harvested key.
+		e.mu.Lock()
+		run := e.findRunLocked(task.Run)
+		if run != nil {
+			for _, row := range run.Rows {
+				if row.View.ID == task.RowID {
+					row.Result = harvest
+					row.View.MaskedKey = maskAPIKey(harvest.APIKey)
+					break
+				}
+			}
+		}
+		errSave := e.persistLocked()
+		e.mu.Unlock()
+		if errSave != nil {
+			return harvest, errSave
+		}
+	} else {
+		// Imported manual keys and pending writes follow the same forwarding
+		// fallback as registration; an unavailable proxy must not strand a key.
+		status := e.gateway.Probe(ctx, false)
+		if status.Mode != GatewayModeController {
+			task.Report("gateway_degraded", "warning", status.Mode)
+		}
+		harvest.VerificationProxyURL = e.gateway.EffectiveProxyURL()
+	}
+	if ctx.Err() != nil {
+		return harvest, ctx.Err()
+	}
+	task.Report(StageVerifyingKey, "info", "verifying captured key before provider write")
+	if e.importer == nil {
+		return harvest, errors.New("registerbot: importer unavailable")
+	}
+	if errImport := e.importer(ctx, task.Channel, harvest); errImport != nil {
+		return harvest, errImport
+	}
+	task.Report(StageWritingKey, "info", "provider key committed")
+	return harvest, nil
+}
+
+func (e *Engine) report(run *queueRun, row *queueRow, stage string) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if !row.busy || run.Status == "paused" || run.Status == "cancelled" {
+		return
+	}
+	switch stage {
+	case StageValidating, StagePinning, StageBrowserStart, StageGoogleLogin, StageWaitingHuman, StageCapturingKey, StageVerifyingKey, StageWritingKey:
+		row.View.Stage = stage
+	case "email", "password", "consent", "google", "speedbump":
+		row.View.Stage = StageGoogleLogin
+	case "key", "reveal", "dashboard":
+		row.View.Stage = StageCapturingKey
+	case "manual", "blocked", "challenge":
+		row.View.Stage = StageWaitingHuman
+	}
+	row.View.UpdatedAt = time.Now().UnixMilli()
+	run.UpdatedAt = row.View.UpdatedAt
+}
+
+func (e *Engine) persistLocked() error {
+	err := e.state.Save(queueDocument{Version: 1, Runs: e.runs})
+	if err != nil {
+		e.storageError = true
+		log.WithField("component", "registerbot").Error("queue persistence failed; scheduling paused")
+		e.bus.Emit(Event{Stage: "storage_error", Level: "error", Message: "queue persistence failed; scheduling paused"})
+		return errors.New("registerbot: queue persistence failed")
+	}
+	e.storageError = false
+	return nil
+}
+
+func (e *Engine) countersLocked(run *queueRun) Counters {
+	c := Counters{ChannelID: run.Channel, Total: len(run.Rows), Stage: run.Status, UpdatedAt: run.UpdatedAt}
+	if channel, ok := e.settings.Channel(run.Channel); ok {
+		c.Target = channel.TargetKeys
+	}
+	for _, row := range run.Rows {
+		switch row.View.Stage {
+		case StageQueued:
+			c.Queued++
+		case StageDone:
+			c.Done++
+		case StageFailed:
+			c.Failed++
+		case StageSkipped:
+			c.Skipped++
+		case StageWaitingHuman:
+			c.Waiting++
+		case StagePendingWrite:
+			c.Pending++
+		case StagePaused:
+		default:
+			c.Running++
+		}
+		if row.Result.APIKey != "" || row.View.Stage == StageDone {
+			c.Got++
+		}
+	}
+	c.Stalled = c.Waiting > 0 || c.Pending > 0
+	return c
+}
+
+func (e *Engine) refreshRunLocked(run *queueRun) {
+	run.UpdatedAt = time.Now().UnixMilli()
+	if run.Status == "paused" || run.Status == "cancelled" {
+		return
+	}
+	c := e.countersLocked(run)
+	switch {
+	case c.Running > 0:
+		run.Status = "running"
+	case c.Queued > 0:
+		run.Status = "queued"
+	case c.Waiting > 0 || c.Pending > 0:
+		run.Status = "waiting_human"
+	case c.Failed > 0 && c.Done > 0:
+		run.Status = "partial"
+	case c.Failed > 0:
+		run.Status = "failed"
+	default:
+		run.Status = "done"
+	}
+}
+
+func (e *Engine) emitProgressLocked(run *queueRun, stage, message string) {
+	c := e.countersLocked(run)
+	e.bus.Emit(Event{Channel: run.Channel, Run: run.ID, Stage: stage, Message: message, Counters: &c})
+}
+
+func (e *Engine) runViewLocked(run *queueRun) RunView {
+	v := RunView{ID: run.ID, Channel: run.Channel, Status: run.Status, CreatedAt: run.CreatedAt, UpdatedAt: run.UpdatedAt, Rows: make([]RowView, 0, len(run.Rows)), Counters: e.countersLocked(run)}
+	for _, row := range run.Rows {
+		v.Rows = append(v.Rows, row.View)
+	}
+	return v
+}
+
+func (e *Engine) findRunLocked(id string) *queueRun {
+	for _, run := range e.runs {
+		if run.ID == id {
+			return run
+		}
+	}
+	return nil
+}
+func maskAPIKey(key string) string {
+	if len(key) < 12 {
+		return "[redacted]"
+	}
+	return key[:3] + "…" + key[len(key)-4:]
+}
+
+func (e *Engine) discardTaskLocked(rowID string) {
+	task := e.tasks[rowID]
+	delete(e.tasks, rowID)
+	if task == nil || task.session == nil {
+		return
+	}
+	session := task.session
+	task.session = nil
+	task.Account.Password = ""
+	e.wg.Add(1)
+	go func() {
+		defer e.wg.Done()
+		if err := session.CloseTarget(e.ctx); err != nil {
+			log.WithField("component", "registerbot").Debug("browser context cleanup deferred to pool shutdown")
+		}
+	}()
+}
+
+func (e *Engine) Close() error {
+	e.mu.Lock()
+	if e.closed {
+		e.mu.Unlock()
+		return nil
+	}
+	e.closed = true
+	e.cancel()
+	e.signalLocked()
+	e.mu.Unlock()
+	e.wg.Wait()
+	e.mu.Lock()
+	errSave := e.persistLocked()
+	e.mu.Unlock()
+	errPool := e.pool.Shutdown()
+	errBus := e.bus.Close()
+	return errors.Join(errSave, errPool, errBus)
+}
