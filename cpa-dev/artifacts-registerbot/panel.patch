+      'failed',
+      'skipped',
+      'paused',
+      'email',
+      'password',
+      'choose_account',
+      'consent',
+      'google',
+      'speedbump',
+      'key',
+      'reveal',
+      'dashboard',
+      'challenge',
+      'blocked',
+      'invalid_credentials',
+      'manual',
+      'loading',
+      'gateway_probe',
+      'gateway_degraded',
+      'browser_degraded',
+      'settings_updated',
+      'storage_error',
+      'network_error',
+      'running',
+      'cancelled',
